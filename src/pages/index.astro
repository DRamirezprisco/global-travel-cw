---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/common/Header.astro';
import Hero from '@/components/home/Hero.astro';
import { getAllContactos, getAllEstatus, getAllPendientes, getDatabase } from '@/utils/db';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
const db = getDatabase(Astro.locals);
const [pendientes, estatusList, contactosList] = await Promise.all([
  getAllPendientes(db),
  getAllEstatus(db),
  getAllContactos(db),
]);
---

<Layout title="Global Travel CW | Panel de Pendientes">
  <Header activeTab="pendientes" />
  <main class="flex-1 min-h-0 flex flex-col overflow-hidden bg-base-muted">
    <Hero clientes={pendientes} estatusList={estatusList} contactosList={contactosList} />
  </main>
</Layout>
