---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/common/Header.astro';
import EstatusPanel from '@/components/estatus/EstatusPanel.astro';
import { getAllEstatus, getDatabase } from '@/utils/db';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
const db = getDatabase(Astro.locals);
const estatusList = await getAllEstatus(db);
---

<Layout title="Global Travel CW | Catálogo de Estatus">
  <Header activeTab="estatus" />
  <main class="flex-1 min-h-0 flex flex-col overflow-hidden bg-base-muted">
    <EstatusPanel estatusList={estatusList} />
  </main>
</Layout>
