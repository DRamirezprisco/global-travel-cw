---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/common/Header.astro';
import ContactosPanel from '@/components/contactos/ContactosPanel.astro';
import { getAllContactos, getAllPendientes, getDatabase } from '@/utils/db';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
const db = getDatabase(Astro.locals);
const [contactos, pendientes] = await Promise.all([
  getAllContactos(db),
  getAllPendientes(db),
]);
---

<Layout title="Global Travel CW | Directorio de Contactos">
  <Header activeTab="contactos" />
  <main class="flex-1 min-h-0 flex flex-col overflow-hidden bg-base-muted">
    <ContactosPanel contactos={contactos} pendientes={pendientes} />
  </main>
</Layout>
