---
import { GRID_COLUMNS } from '@/constants/site';
import { ALL_CLIENTE_STATUS_LIST, CLIENTE_STATUS_LIST, STATUS_CONFIGS } from '@/constants/statuses';
import type { ClienteRecord, ContactoRecord, EstatusRecord } from '@/types';
import { buildWhatsAppDynamicLink } from '@/utils/pagoHelpers';

interface Props {
  clientes: ClienteRecord[];
  estatusList?: EstatusRecord[];
  contactosList?: ContactoRecord[];
  initialHoyMode?: boolean;
}

const {
  clientes,
  estatusList = [],
  contactosList = [],
  initialHoyMode = false,
} = Astro.props;

// Estatus activos para los filtros superiores (excluyendo Finalizado)
const activeStatuses =
  estatusList.length > 0
    ? estatusList.filter(
        (e) => e.codigo !== 'finalizado' && e.nombre.toLowerCase() !== 'finalizado'
      )
    : CLIENTE_STATUS_LIST.map((name) => ({
        id: 0,
        nombre: name,
        codigo: name,
        color: '#ff0000',
      }));

// Todos los estatus disponibles para el modal (incluyendo Finalizado y nuevos estatus)
const allModalStatuses =
  estatusList.length > 0
    ? estatusList
    : ALL_CLIENTE_STATUS_LIST.map((name) => ({
        id: 0,
        nombre: name,
        codigo: name,
        color: '#1e3a8a',
      }));

// Diccionario de colores por nombre de estatus
const estatusColorMap: Record<string, string> = {};
estatusList.forEach((e) => {
  estatusColorMap[e.nombre] = e.color;
});

const statusCounts = activeStatuses.reduce(
  (acc, item) => {
    acc[item.nombre] = clientes.filter((c) => c.status === item.nombre).length;
    return acc;
  },
  {} as Record<string, number>
);
---

<section
  id="hero-pendientes-container"
  data-contactos={JSON.stringify(contactosList)}
  data-initial-hoy={initialHoyMode ? 'true' : 'false'}
  class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6"
>
  <!-- Tarjetas / Píldoras de los Estatus de Pendientes -->
  <div class="bg-base rounded-xl border border-base-border p-4 shadow-xs">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-2.5">
      {
        activeStatuses.map((st) => {
          const cfg = STATUS_CONFIGS[st.nombre as keyof typeof STATUS_CONFIGS];
          const color = st.color || '#1e3a8a';
          const count = statusCounts[st.nombre] ?? 0;
          return (
            <button
              type="button"
              data-status-pill={st.nombre}
              title={`Filtrar por ${st.nombre}`}
              class={`status-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3 py-2 text-left transition hover:shadow-sm cursor-pointer ${
                cfg?.badgeClass || ''
              }`}
              style={`background-color: ${color}14; border-color: ${color}55; color: ${color};`}
            >
              <div class="flex items-center gap-2 min-w-0">
                <span
                  class={`h-2.5 w-2.5 shrink-0 rounded-full ${cfg?.dotClass || ''}`}
                  style={`background-color: ${color}; ring-color: ${color}40;`}
                />
                <span class="text-xs font-bold truncate">{st.nombre}</span>
              </div>
              <span
                data-status-count={st.nombre}
                class="inline-flex items-center justify-center rounded-md bg-base/90 text-primary px-2 py-0.5 text-xs font-extrabold shrink-0 border border-base-border"
              >
                {count}
              </span>
            </button>
          );
        })
      }
    </div>
  </div>

  <!-- Banner Informativo del Modo "Pendientes Hoy" -->
  <div
    id="banner-pendientes-hoy"
    class={`rounded-xl border-2 border-amber-400 bg-amber-50/90 p-4 shadow-xs transition ${initialHoyMode ? '' : 'hidden'}`}
  >
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-600 px-3 py-1 text-xs font-extrabold text-white shadow-xs">
            📅 PENDIENTES DE HOY Y +1 DÍA
          </span>
          <span id="hoy-range-summary" class="text-xs font-extrabold text-primary">
            Cargando rango de fechas...
          </span>
        </div>
        <p class="text-xs text-primary/80 leading-relaxed">
          <strong>Vuelos / Multiruta (Datos del Vuelo):</strong> Filtra fecha actual y 1 día después (ej. <code class="bg-white/80 px-1 rounded">22NOV MARCUR</code> → <code class="bg-white/80 px-1 rounded">22/11/2026</code>; en multirutas como <code class="bg-white/80 px-1 rounded">27DEC CURMAR / 10JAN CURMAR</code> evalúa ambas fechas ordenando primero la más cercana y luego la más lejana).
          <strong class="ml-1">Reserva por 24h:</strong> Filtra por <strong>Fecha de Gestión</strong> que vence hoy (de hoy y de ayer).
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <label for="input-hoy-ref-date" class="text-xs font-extrabold uppercase text-primary/80">
          Fecha base:
        </label>
        <input
          type="date"
          id="input-hoy-ref-date"
          class="rounded-lg border border-amber-400 bg-base px-2.5 py-1.5 text-xs font-bold text-primary focus:border-primary focus:outline-none cursor-pointer"
        />
        <button
          type="button"
          id="btn-reset-hoy-date"
          title="Restablecer a la fecha actual de hoy"
          class="rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-extrabold px-3 py-1.5 text-xs transition cursor-pointer"
        >
          Hoy
        </button>
        <button
          type="button"
          id="btn-exit-hoy-mode"
          class="rounded-lg border border-primary/30 bg-base hover:bg-base-muted text-primary font-bold px-3 py-1.5 text-xs transition cursor-pointer"
        >
          Ver Todos los Pendientes ✕
        </button>
      </div>
    </div>
  </div>

  <!-- Barra de búsqueda por nombre, botón Pendientes de Hoy y contador de registros -->
  <div class="bg-base rounded-xl border border-base-border p-4 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex flex-1 flex-col sm:flex-row items-stretch sm:items-center gap-2.5 max-w-2xl">
      <div class="relative flex-1">
        <input
          type="search"
          id="input-search-clientes"
          placeholder="Buscar por nombre..."
          class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 text-sm text-primary placeholder:text-primary/50 focus:border-primary focus:bg-base focus:outline-none"
        />
      </div>

      <!-- Botón de Pendientes de Hoy dentro del menú Pendientes -->
      <button
        type="button"
        id="btn-toggle-pendientes-hoy"
        title="Ver pendientes de hoy y +1 día (por Datos del Vuelo) y Reservas 24h por vencer (hoy y ayer)"
        class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-amber-500 bg-amber-50 hover:bg-amber-500 hover:text-white text-amber-900 font-extrabold px-3.5 py-2 text-xs shadow-xs transition cursor-pointer whitespace-nowrap"
      >
        <span>📅</span>
        <span>Pendientes de Hoy</span>
        <span
          id="badge-count-pendientes-hoy"
          class="inline-flex items-center justify-center rounded-full bg-amber-600 text-white px-2 py-0.5 text-[11px] font-extrabold"
        >
          0
        </span>
      </button>
    </div>

    <div class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-primary">
      <span id="visible-rows-counter">
        Mostrando <strong>{clientes.length}</strong> de <strong>{clientes.length}</strong>
      </span>
      <span
        id="d1-sync-toast"
        class="hidden rounded-md bg-status-emitida-bg text-status-emitida-text border border-status-emitida-border px-2.5 py-1 text-xs font-bold"
      >
        Guardado en D1
      </span>
      <div class="flex flex-wrap items-center gap-2 ml-auto sm:ml-0">
        <button
          type="button"
          id="btn-delete-selected-pendientes"
          title="Eliminar los pendientes marcados (los contactos se mantienen intactos)"
          class="hidden rounded-lg bg-secondary/10 border border-secondary text-secondary hover:bg-secondary hover:text-base font-extrabold px-3.5 py-2 text-xs shadow-xs transition items-center gap-1.5 cursor-pointer"
        >
          <span>🗑️</span>
          <span id="label-delete-selected">Eliminar Seleccionados (0)</span>
        </button>
        <button
          type="button"
          id="btn-delete-all-pendientes"
          title="Eliminar pendientes actuales manteniendo el directorio de Contactos intacto"
          class="rounded-lg border border-secondary/60 bg-base hover:bg-secondary hover:text-base text-secondary font-bold px-3.5 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer"
        >
          <span>🗑️</span>
          <span id="label-delete-all">Eliminar Pendientes</span>
        </button>
        <button
          type="button"
          data-export-excel="true"
          title="Descargar Reporte Operativo en Excel (.xlsx)"
          class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3.5 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer disabled:opacity-60"
        >
          <span>📊</span>
          <span data-export-excel-label>Excel</span>
        </button>
        <button
          type="button"
          data-export-pdf="true"
          title="Descargar Reporte Operativo en PDF (.pdf)"
          class="rounded-lg bg-secondary hover:bg-secondary-light text-white font-bold px-3.5 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer disabled:opacity-60"
        >
          <span>📄</span>
          <span data-export-pdf-label>PDF</span>
        </button>
        <button
          type="button"
          id="btn-open-new-modal"
          class="rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-base font-bold px-4 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer"
        >
          <span>+</span>
          <span>Nuevo Pendiente</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Tabla Grid Maestra Unificada (6 Columnas Fijas, Clic en Fila abre Ventana Completa) -->
  <div class="bg-base rounded-xl border border-base-border shadow-xs overflow-hidden">
    <div
      tabindex="0"
      role="region"
      aria-labelledby="clientes-table-caption"
      class="table-wrapper"
    >
      <table class="clientes-table text-left text-sm">
        <caption id="clientes-table-caption" class="sr-only">
          Tabla unificada de pendientes de Global Travel CW almacenada en Cloudflare D1
        </caption>
        <thead class="bg-primary text-base text-xs uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[260px]">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  id="select-all-pendientes"
                  title="Seleccionar todos los pendientes visibles"
                  aria-label="Seleccionar todos los pendientes visibles"
                  class="h-4 w-4 rounded border-base/60 accent-secondary cursor-pointer"
                />
                <span>{GRID_COLUMNS.contacto}</span>
              </div>
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[210px]">
              {GRID_COLUMNS.status}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[125px]">
              {GRID_COLUMNS.fecha_gestion}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[240px]">
              {GRID_COLUMNS.solicitud_vuelo}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[300px]">
              {GRID_COLUMNS.observacion}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[130px]">
              {GRID_COLUMNS.monto}
            </th>
          </tr>
        </thead>
        <tbody id="clientes-tbody" class="divide-y divide-base-border">
          {
            clientes.map((cliente) => {
              const cfg = STATUS_CONFIGS[cliente.status as keyof typeof STATUS_CONFIGS];
              const statusColor = cliente.status_color || estatusColorMap[cliente.status] || '#1e3a8a';
              const waInfo = buildWhatsAppDynamicLink(cliente.contacto, undefined, contactosList, cliente.solicitud_vuelo);
              return (
                <tr
                  tabindex="0"
                  role="button"
                  aria-label={`Abrir detalle completo de ${cliente.contacto}`}
                  data-row-id={cliente.id}
                  data-row-status={cliente.status}
                  data-row-name={cliente.contacto}
                  data-row-record={JSON.stringify(cliente)}
                  class="hover:bg-base-muted focus:bg-base-muted focus:outline-none transition-colors cursor-pointer"
                >
                  <th
                    scope="row"
                    data-cell-contacto={cliente.id}
                    class="py-3.5 px-4 font-bold text-primary border-r border-base-border align-middle"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <input
                          type="checkbox"
                          data-row-checkbox="true"
                          data-select-pendiente={cliente.id}
                          aria-label={`Seleccionar pendiente de ${cliente.contacto}`}
                          class="h-4 w-4 shrink-0 rounded border-base-border accent-secondary cursor-pointer"
                        />
                        <span data-name-for={cliente.id} class="text-sm leading-snug">{cliente.contacto}</span>
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <a
                          href={waInfo.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-whatsapp-link="true"
                          data-wa-for={cliente.id}
                          title={waInfo.label}
                          aria-label={waInfo.label}
                          class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white shadow-xs transition transform hover:scale-105"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.531 5.86L0 24l6.335-1.652c1.688.919 3.621 1.444 5.666 1.444 6.627 0 12-5.373 12-12s-5.373-12-11.993-12z"/></svg>
                        </a>
                        <button
                          type="button"
                          data-delete-pendiente={cliente.id}
                          data-delete-name={cliente.contacto}
                          title={`Eliminar pendiente de ${cliente.contacto} (mantiene el contacto intacto)`}
                          aria-label={`Eliminar pendiente de ${cliente.contacto}`}
                          class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-secondary/10 border border-secondary/40 text-secondary hover:bg-secondary hover:text-base active:bg-secondary-dark shadow-xs transition cursor-pointer"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                      </div>
                    </div>
                  </th>

                  <td class="py-3.5 px-4 align-middle">
                    <span
                      data-badge-for={cliente.id}
                      class={`inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-bold w-fit ${
                        cfg?.badgeClass || ''
                      }`}
                      style={`background-color: ${statusColor}18; color: ${statusColor}; border-color: ${statusColor}55;`}
                    >
                      <span
                        data-dot-for={cliente.id}
                        class={`h-2.5 w-2.5 shrink-0 rounded-full ${cfg?.dotClass || ''}`}
                        style={`background-color: ${statusColor}; ring-color: ${statusColor}40;`}
                      />
                      <span data-label-for={cliente.id}>{cliente.status}</span>
                    </span>
                  </td>

                  <td
                    data-cell-fecha={cliente.id}
                    class="py-3.5 px-4 align-middle text-xs font-medium text-primary whitespace-nowrap"
                  >
                    {cliente.fecha_gestion}
                  </td>

                  <td
                    data-cell-vuelo={cliente.id}
                    class="py-3.5 px-4 align-middle text-xs font-semibold text-primary"
                  >
                    <div class="space-y-1">
                      <div data-vuelo-text={cliente.id}>{cliente.solicitud_vuelo}</div>
                      <div
                        data-hoy-badge={cliente.id}
                        class="hidden text-[11px] font-extrabold rounded px-2 py-0.5 w-fit bg-amber-100 text-amber-900 border border-amber-300"
                      ></div>
                    </div>
                  </td>

                  <td
                    data-cell-observacion={cliente.id}
                    class="py-3.5 px-4 align-middle text-xs text-primary/90 leading-relaxed"
                  >
                    {cliente.observacion}
                  </td>

                  <td
                    data-cell-precio={cliente.id}
                    class="py-3.5 px-4 align-middle text-xs font-extrabold"
                  >
                    <div class="flex flex-col gap-0.5">
                      {cliente.monto !== '-' ? (
                        <span class="text-secondary">{cliente.monto}</span>
                      ) : (
                        <span class="text-primary/40 font-normal">-</span>
                      )}
                      {cliente.abono && cliente.abono !== '-' && (
                        <span class="text-[11px] font-bold text-amber-700">Abono: {cliente.abono}</span>
                      )}
                      {cliente.ganancia && cliente.ganancia !== '-' && (
                        <span class="text-[11px] font-bold text-emerald-700">Ganancia: {cliente.ganancia}</span>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Ventana Modal Completa (<dialog>) para Ver, Editar, Guardar Cambios o Eliminar en Cloudflare D1 -->
<dialog
  id="modal-cliente"
  aria-labelledby="modal-title"
  {...({ closedby: 'any' } as any)}
  class="m-auto w-[94vw] max-w-2xl rounded-2xl border-2 border-primary bg-base p-0 text-primary shadow-2xl backdrop:bg-primary-dark/60 overflow-hidden"
>
  <form id="form-cliente" class="flex flex-col overflow-hidden">
    <!-- Cabecera del Modal -->
    <div class="shrink-0 flex items-center justify-between bg-primary px-6 py-3.5 text-base border-b-4 border-secondary">
      <div>
        <h3 id="modal-title" class="text-base sm:text-lg font-extrabold">
          Cliente
        </h3>
        <p id="modal-subtitle" class="text-xs text-base-muted opacity-85 mt-0.5">
          Todos los campos son editables y se guardan en Cloudflare D1
        </p>
      </div>
      <button
        type="button"
        id="btn-close-modal"
        class="rounded-lg bg-primary-dark px-3 py-1.5 text-xs font-bold text-base hover:bg-secondary transition cursor-pointer"
      >
        Cerrar ✕
      </button>
    </div>

    <!-- Cuerpo del Formulario (único contenedor con scroll) -->
    <div class="flex-auto min-h-0 p-6 space-y-4 text-sm overflow-y-auto overscroll-contain">
      <input type="hidden" id="field-id" name="id" value="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Siempre: Cliente con Autocompletado de Contactos -->
        <div id="container-contacto" class="sm:col-span-2 relative">
          <label for="field-contacto" class="block text-xs font-bold uppercase text-primary mb-1">
            Cliente (Nombre / Teléfono) *
          </label>
          <div class="relative">
            <input
              type="text"
              id="field-contacto"
              name="contacto"
              required
              autocomplete="off"
              placeholder="Ej. Jaime Goenaga Pax | +599 9 600 0000"
              class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 text-primary font-semibold focus:border-primary focus:bg-base focus:outline-none"
            />
            <!-- Lista de Sugerencias de Contactos -->
            <ul
              id="contacto-suggestions"
              class="hidden absolute z-50 left-0 right-0 mt-1 max-h-56 overflow-y-auto rounded-lg border border-base-border bg-base shadow-xl divide-y divide-base-border text-xs"
            >
            </ul>
          </div>
        </div>

        <!-- Siempre: Estatus -->
        <div id="container-status">
          <label for="field-status" class="block text-xs font-bold uppercase text-primary mb-1">
            Estatus *
          </label>
          <select
            id="field-status"
            name="status"
            required
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 font-bold text-primary focus:border-primary focus:bg-base focus:outline-none cursor-pointer"
          >
            {
              allModalStatuses.map((st) => (
                <option value={st.nombre}>{st.nombre}</option>
              ))
            }
          </select>
        </div>

        <!-- Siempre: Fecha -->
        <div id="container-fecha">
          <label for="field-fecha" class="block text-xs font-bold uppercase text-primary mb-1">
            Fecha (Gestión / Reserva / Factura)
          </label>
          <input
            type="text"
            id="field-fecha"
            name="fecha_gestion"
            placeholder="DD/MM/AA"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Condicional: Datos del Vuelo -->
        <div id="container-solicitud" class="sm:col-span-2">
          <label for="field-solicitud" class="block text-xs font-bold uppercase text-primary mb-1">
            Datos del Vuelo (Solicitud / Ruta / Fechas de Vuelo)
          </label>
          <input
            type="text"
            id="field-solicitud"
            name="solicitud_vuelo"
