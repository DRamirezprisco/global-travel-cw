  const fAbono = document.querySelector<HTMLInputElement>('#field-abono');
  const fAbonoMoneda = document.querySelector<HTMLSelectElement>('#field-abono-moneda');
  const fGanancia = document.querySelector<HTMLInputElement>('#field-ganancia');
  const fGananciaMoneda = document.querySelector<HTMLSelectElement>('#field-ganancia-moneda');

  function splitAmountAndCurrency(raw: string | undefined | null): { amount: string; currency: 'Fls' | '$' } {
    if (!raw || raw.trim() === '-' || raw.trim() === '') {
      return { amount: '', currency: 'Fls' };
    }
    const isDollar = raw.includes('$') || /usd/i.test(raw);
    const cleanAmount = raw.replace(/fls|usd|\$/gi, '').trim();
    return {
      amount: cleanAmount === '-' ? '' : cleanAmount,
      currency: isDollar ? '$' : 'Fls',
    };
  }

  function combineAmountAndCurrency(rawAmount: string | undefined, currency: string | undefined): string {
    const clean = (rawAmount || '').replace(/fls|usd|\$/gi, '').trim();
    if (!clean || clean === '-') return '-';
    const curr = currency === '$' ? '$' : 'Fls';
    return `${clean} ${curr}`;
  }
  const fAerolinea = document.querySelector<HTMLInputElement>('#field-aerolinea');
