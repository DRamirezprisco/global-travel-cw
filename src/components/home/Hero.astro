  const bannerHoy = document.querySelector<HTMLElement>('#banner-pendientes-hoy');
  const btnToggleHoy = document.querySelector<HTMLButtonElement>('#btn-toggle-pendientes-hoy');
  const badgeCountHoy = document.querySelector<HTMLElement>('#badge-count-pendientes-hoy');
  const hoyRangeSummary = document.querySelector<HTMLElement>('#hoy-range-summary');
  const inputHoyRefDate = document.querySelector<HTMLInputElement>('#input-hoy-ref-date');
  const btnResetHoyDate = document.querySelector<HTMLButtonElement>('#btn-reset-hoy-date');
  const btnExitHoyMode = document.querySelector<HTMLButtonElement>('#btn-exit-hoy-mode');

  function getTodayInputIso(): string {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  if (inputHoyRefDate && !inputHoyRefDate.value) {
    inputHoyRefDate.value = getTodayInputIso();
  }

  function getReferenceDate(): Date {
    const val = inputHoyRefDate?.value;
    if (val && /^\d{4}-\d{2}-\d{2}$/.test(val)) {
      const [y, m, d] = val.split('-').map(Number);
      return createMidnightDate(y, m, d);
    }
    const now = new Date();
    return createMidnightDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
  }

  const tbody = document.querySelector<HTMLTableSectionElement>('#clientes-tbody');
  const visibleCounter = document.querySelector<HTMLElement>('#visible-rows-counter');
  const syncToast = document.querySelector<HTMLElement>('#d1-sync-toast');

  const modal = document.querySelector<HTMLDialogElement>('#modal-cliente');
