  const cLocalizador = document.querySelector<HTMLElement>('#container-localizador');
  const cApellidos = document.querySelector<HTMLElement>('#container-apellidos');
  const cCheckin = document.querySelector<HTMLElement>('#container-checkin');

  const KNOWN_AIRLINES = [
    'dividivi',
    'latam',
    'avior',
    'wingo',
    'zair',
    'aeroparaguana',
    'avianca',
    'arajet',
    'copaairlines',
    'copa',
    'klm',
    'redair',
    'laser',
  ];

  function parseCodigo(codigo: string, record?: Partial<ClienteRecord>) {
    if (record?.aerolinea || record?.localizador || record?.apellidos) {
      return {
        aerolinea: record.aerolinea !== '-' ? (record.aerolinea ?? '') : '',
        localizador: record.localizador !== '-' ? (record.localizador ?? '') : '',
        apellidos: record.apellidos !== '-' ? (record.apellidos ?? '') : '',
      };
    }

    if (!codigo || codigo === '-') {
      return { aerolinea: '', localizador: '', apellidos: '' };
    }

    let partA = codigo;
    let apellidos = '';
    if (codigo.includes('/')) {
      const slashIdx = codigo.indexOf('/');
      partA = codigo.slice(0, slashIdx).trim();
      apellidos = codigo.slice(slashIdx + 1).trim();
    }

    let aerolinea = '';
    let localizador = '';
    if (partA.includes('|')) {
      const pipeParts = partA.split('|').map((s) => s.trim());
      aerolinea = pipeParts[0] || '';
      localizador = pipeParts.slice(1).join(' | ');
    } else {
      const trimmed = partA.trim();
      if (KNOWN_AIRLINES.includes(trimmed.toLowerCase())) {
        aerolinea = trimmed;
      } else {
        localizador = trimmed;
      }
    }

    return { aerolinea, localizador, apellidos };
  }

  function toggleContainer(el: HTMLElement | null, show: boolean) {
    if (!el) return;
    if (show) {
      el.classList.remove('hidden');
    } else {
      el.classList.add('hidden');
    }
  }

  function updateModalFieldVisibility() {
    const currentStatus = fStatus?.value ?? '';

    const hasVuelo = [
      'Pendiente Cotizacion',
      'Cotizacion Enviada',
      'Reserva por 24h',
      'Reserva Emitida',
    ].includes(currentStatus);

    const hasPrecio = [
      'Pendiente Cotizacion',
      'Cotizacion Enviada',
      'Reserva por 24h',
      'Reserva Emitida',
      'Cambio Tickets',
      'Visas',
      'Consultas',
      'Finalizado',
    ].includes(currentStatus) || Boolean(currentStatus);

    const hasReservaFields = [
      'Reserva por 24h',
      'Reserva Emitida',
    ].includes(currentStatus);

    const hasCheckin = currentStatus === 'Reserva Emitida';

    toggleContainer(cSolicitud, hasVuelo);
    toggleContainer(cMonto, hasPrecio);
    toggleContainer(cAerolinea, hasReservaFields);
    toggleContainer(cLocalizador, hasReservaFields);
    toggleContainer(cApellidos, hasReservaFields);
    toggleContainer(cCheckin, hasCheckin);
  }

  fStatus?.addEventListener('change', updateModalFieldVisibility);

  function showSyncToast(message: string) {
    if (!syncToast) return;
    syncToast.textContent = message;
    syncToast.classList.remove('hidden');
    window.setTimeout(() => {
      syncToast.classList.add('hidden');
    }, 2600);
  }

  function applyFilters() {
    if (!tbody) return;
    const query = (searchInput?.value ?? '').toLowerCase().trim();
    const refDate = getReferenceDate();
    const tomorrowDate = createMidnightDate(
      refDate.getFullYear(),
      refDate.getMonth() + 1,
      refDate.getDate() + 1
    );
    const yesterdayDate = createMidnightDate(
      refDate.getFullYear(),
      refDate.getMonth() + 1,
      refDate.getDate() - 1
    );

    if (hoyRangeSummary) {
      const strHoy = formatDateDDMMYYYY(refDate.getDate(), refDate.getMonth() + 1, refDate.getFullYear());
      const strManana = formatDateDDMMYYYY(
        tomorrowDate.getDate(),
        tomorrowDate.getMonth() + 1,
        tomorrowDate.getFullYear()
      );
      const strAyer = formatDateDDMMYYYY(
        yesterdayDate.getDate(),
        yesterdayDate.getMonth() + 1,
        yesterdayDate.getFullYear()
      );
      hoyRangeSummary.textContent = `Vuelos: Hoy (${strHoy}) y Mañana (${strManana}) | Reserva 24h por vencer: Ayer (${strAyer}) y Hoy (${strHoy})`;
    }

    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));

    let visibleCount = 0;
    let totalHoyMatches = 0;
    const rowSortMeta = new Map<HTMLTableRowElement, { primary: number; secondary: number; id: number }>();

    for (const row of rows) {
      const rowId = Number(row.dataset.rowId || 0);
      const rowStatus = row.dataset.rowStatus ?? '';
      const rowName = (row.dataset.rowName ?? '').toLowerCase();
      let record: ClienteRecord | null = null;
      try {
        record = JSON.parse(row.dataset.rowRecord || '') as ClienteRecord;
      } catch {}

      const evalHoy = record
        ? evaluatePendienteForHoy(record, refDate)
        : {
            matches: false,
            isReserva24h: false,
            parsedDates: [],
            matchedDate: null,
            matchLabel: '-',
            sortTimestamp: Number.MAX_SAFE_INTEGER,
            secondarySortTimestamp: Number.MAX_SAFE_INTEGER,
          };

      if (evalHoy.matches) {
        totalHoyMatches++;
      }

      // Actualizar etiqueta visual de fechas detectadas en la celda Datos del Vuelo
      const hoyBadge = row.querySelector<HTMLElement>(`[data-hoy-badge="${rowId}"]`);
      if (hoyBadge && record) {
        if (evalHoy.matches) {
          hoyBadge.textContent = evalHoy.matchLabel;
          hoyBadge.className = evalHoy.isReserva24h
            ? 'text-[11px] font-extrabold rounded px-2 py-0.5 w-fit bg-sky-100 text-sky-900 border border-sky-300'
            : 'text-[11px] font-extrabold rounded px-2 py-0.5 w-fit bg-amber-100 text-amber-900 border border-amber-300';
        } else if (isHoyMode) {
          hoyBadge.classList.add('hidden');
        } else {
          // En modo normal, si tiene fechas compuestas / multiruta, mostrar las fechas detectadas ordenadas de más cercana a más lejana
          const extracted = extractFlightDatesFromText(record.solicitud_vuelo, refDate);
          if (extracted.length > 0) {
            const chronological = [...extracted].sort((a, b) => a.timestamp - b.timestamp);
            hoyBadge.textContent = `📅 ${chronological.map((d) => d.formatted).join(' → ')}`;
            hoyBadge.className =
              'text-[11px] font-bold rounded px-2 py-0.5 w-fit bg-base-muted text-primary/75 border border-base-border';
          } else {
            hoyBadge.classList.add('hidden');
          }
        }
      }

      rowSortMeta.set(row, {
        primary: evalHoy.sortTimestamp,
        secondary: evalHoy.secondarySortTimestamp,
        id: rowId,
      });

      const matchesStatus = selectedStatus === 'ALL' || rowStatus === selectedStatus;
      const matchesQuery =
        !query ||
        rowName.includes(query) ||
        (record?.solicitud_vuelo || '').toLowerCase().includes(query);
      const matchesHoy = !isHoyMode || evalHoy.matches;

      if (matchesStatus && matchesQuery && matchesHoy) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    }

    // Si estamos en "Pendientes Hoy", ordenar filas primero por la fecha más cercana y luego por la más lejana
    if (isHoyMode) {
      const sortedRows = [...rows].sort((a, b) => {
        const metaA = rowSortMeta.get(a)!;
        const metaB = rowSortMeta.get(b)!;
        if (metaA.primary !== metaB.primary) return metaA.primary - metaB.primary;
        if (metaA.secondary !== metaB.secondary) return metaA.secondary - metaB.secondary;
        return metaA.id - metaB.id;
      });
      for (const r of sortedRows) {
        tbody.appendChild(r);
      }
    } else {
      // Orden original por ID en vista general
      const sortedById = [...rows].sort(
        (a, b) => Number(a.dataset.rowId || 0) - Number(b.dataset.rowId || 0)
      );
      for (const r of sortedById) {
        tbody.appendChild(r);
      }
    }

    if (badgeCountHoy) {
      badgeCountHoy.textContent = String(totalHoyMatches);
    }

    if (bannerHoy) {
      if (isHoyMode) {
        bannerHoy.classList.remove('hidden');
      } else {
        bannerHoy.classList.add('hidden');
      }
    }

    if (btnToggleHoy) {
      if (isHoyMode) {
        btnToggleHoy.classList.remove('bg-amber-50', 'text-amber-900');
        btnToggleHoy.classList.add('bg-amber-500', 'text-white', 'ring-2', 'ring-amber-300');
      } else {
        btnToggleHoy.classList.add('bg-amber-50', 'text-amber-900');
        btnToggleHoy.classList.remove('bg-amber-500', 'text-white', 'ring-2', 'ring-amber-300');
      }
    }

    if (visibleCounter) {
      visibleCounter.innerHTML = isHoyMode
        ? `Pendientes Hoy: <strong>${visibleCount}</strong> de <strong>${rows.length}</strong>`
        : `Mostrando <strong>${visibleCount}</strong> de <strong>${rows.length}</strong>`;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-status-pill]').forEach((pill) => {
      if (selectedStatus !== 'ALL' && pill.dataset.statusPill === selectedStatus) {
        pill.classList.add('ring-2', 'ring-primary', 'scale-[1.02]');
      } else {
        pill.classList.remove('ring-2', 'ring-primary', 'scale-[1.02]');
      }
    });
  }

  function recalculateStatusCounts() {
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));
    const counts: Record<string, number> = {};

    for (const row of rows) {
      const st = row.dataset.rowStatus ?? '';
      counts[st] = (counts[st] || 0) + 1;
    }

    document.querySelectorAll<HTMLElement>('[data-status-count]').forEach((badge) => {
      const st = badge.dataset.statusCount ?? '';
      badge.textContent = String(counts[st] || 0);
    });

    const headerTotal = document.getElementById('header-total-count');
    if (headerTotal) headerTotal.textContent = String(rows.length);
  }

  function openClientModal(record: ClienteRecord) {
    if (!modal || !form) return;

    if (modalTitle) {
      modalTitle.textContent = 'Cliente';
    }
    if (modalSubtitle) {
      modalSubtitle.textContent = `Última act. D1: ${record.updated_at || 'Reciente'}`;
    }

    if (fId) fId.value = String(record.id);
    if (fContacto) fContacto.value = record.contacto;
    if (fStatus) fStatus.value = record.status;
    if (fFecha) fFecha.value = record.fecha_gestion === '-' ? '' : record.fecha_gestion;
    if (fSolicitud) fSolicitud.value = record.solicitud_vuelo === '-' ? '' : record.solicitud_vuelo;

    const parsedMonto = splitAmountAndCurrency(record.monto);
    if (fMonto) fMonto.value = parsedMonto.amount;
    if (fMontoMoneda) fMontoMoneda.value = parsedMonto.currency;

    const parsedAbono = splitAmountAndCurrency(record.abono);
    if (fAbono) fAbono.value = parsedAbono.amount;
    if (fAbonoMoneda) fAbonoMoneda.value = parsedAbono.currency;

    const parsedGanancia = splitAmountAndCurrency(record.ganancia);
    if (fGanancia) fGanancia.value = parsedGanancia.amount;
    if (fGananciaMoneda) fGananciaMoneda.value = parsedGanancia.currency;

    const parsed = parseCodigo(record.codigo, record);
    if (fAerolinea) fAerolinea.value = parsed.aerolinea;
    if (fLocalizador) fLocalizador.value = parsed.localizador;
    if (fApellidos) fApellidos.value = parsed.apellidos;

    if (fCheckin) {
      const cVal = (record.checkin ?? '').trim();
      fCheckin.value = (cVal === 'Pendiente' || cVal === 'Completado') ? cVal : '-';
    }
    if (fObservacion) fObservacion.value = record.observacion === '-' ? '' : record.observacion;

    updateModalFieldVisibility();

    if (btnDeleteModal) btnDeleteModal.classList.remove('hidden');
    if (btnSubmitModal) btnSubmitModal.textContent = 'Guardar Cambios';

    modal.showModal();
  }

  // Eventos de búsqueda, Pendientes de Hoy y filtro por estatus
  searchInput?.addEventListener('input', applyFilters);

  btnToggleHoy?.addEventListener('click', () => {
    isHoyMode = !isHoyMode;
    applyFilters();
    updateSelectionUI();
  });

  btnExitHoyMode?.addEventListener('click', () => {
    isHoyMode = false;
    applyFilters();
    updateSelectionUI();
  });

  inputHoyRefDate?.addEventListener('change', () => {
    applyFilters();
    updateSelectionUI();
  });

  btnResetHoyDate?.addEventListener('click', () => {
    if (inputHoyRefDate) {
      inputHoyRefDate.value = getTodayInputIso();
    }
    applyFilters();
    updateSelectionUI();
  });

  resetBtn?.addEventListener('click', () => {
    selectedStatus = 'ALL';
    if (searchInput) searchInput.value = '';
    applyFilters();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-status-pill]').forEach((pill) => {
    pill.addEventListener('click', () => {
      const targetStatus = pill.dataset.statusPill ?? 'ALL';
      selectedStatus = selectedStatus === targetStatus ? 'ALL' : targetStatus;
      applyFilters();
      updateSelectionUI();
    });
  });

  const selectAllCheckbox = document.querySelector<HTMLInputElement>('#select-all-pendientes');
  const btnDeleteSelected = document.querySelector<HTMLButtonElement>('#btn-delete-selected-pendientes');
  const labelDeleteSelected = document.querySelector<HTMLElement>('#label-delete-selected');
  const btnDeleteAll = document.querySelector<HTMLButtonElement>('#btn-delete-all-pendientes');
  const labelDeleteAll = document.querySelector<HTMLElement>('#label-delete-all');

  function getSelectedPendienteIds(): number[] {
    if (!tbody) return [];
    return Array.from(tbody.querySelectorAll<HTMLInputElement>('input[data-select-pendiente]:checked'))
      .map((cb) => Number(cb.dataset.selectPendiente))
      .filter((n) => Number.isInteger(n) && n > 0);
  }

  function updateSelectionUI() {
    const selectedIds = getSelectedPendienteIds();
    if (btnDeleteSelected && labelDeleteSelected) {
      if (selectedIds.length > 0) {
        btnDeleteSelected.classList.remove('hidden');
        btnDeleteSelected.classList.add('flex');
        labelDeleteSelected.textContent = `Eliminar Seleccionados (${selectedIds.length})`;
      } else {
        btnDeleteSelected.classList.add('hidden');
        btnDeleteSelected.classList.remove('flex');
      }
    }

    if (labelDeleteAll) {
      labelDeleteAll.textContent =
        selectedStatus !== 'ALL'
          ? `Eliminar "${selectedStatus}"`
          : 'Eliminar Todos los Pendientes';
    }

    if (selectAllCheckbox && tbody) {
      const visibleCheckboxes = Array.from(
        tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]')
      )
        .filter((r) => r.style.display !== 'none')
        .map((r) => r.querySelector<HTMLInputElement>('input[data-select-pendiente]'))
        .filter((cb): cb is HTMLInputElement => Boolean(cb));

      selectAllCheckbox.checked =
        visibleCheckboxes.length > 0 && visibleCheckboxes.every((cb) => cb.checked);
    }
  }

  selectAllCheckbox?.addEventListener('change', () => {
    if (!tbody) return;
    const checked = selectAllCheckbox.checked;
    Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]')).forEach((row) => {
      if (row.style.display === 'none') return;
      const cb = row.querySelector<HTMLInputElement>('input[data-select-pendiente]');
      if (cb) cb.checked = checked;
    });
    updateSelectionUI();
  });

  tbody?.addEventListener('change', (event) => {
    const target = event.target as HTMLElement;
    if (target.matches('input[data-select-pendiente]')) {
      updateSelectionUI();
    }
  });

  // Eliminar pendientes seleccionados manteniendo contactos intactos
  btnDeleteSelected?.addEventListener('click', async () => {
    const ids = getSelectedPendienteIds();
    if (ids.length === 0) return;

    const confirmed = window.confirm(
      `¿Estás seguro de eliminar ${ids.length} pendiente(s) seleccionado(s)?\n\n✅ Los contactos en el directorio de Contactos se mantendrán 100% intactos.`
    );
    if (!confirmed) return;

    btnDeleteSelected.disabled = true;
    try {
      const response = await fetch('/api/pendientes', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids }),
      });

      if (response.ok) {
        ids.forEach((id) => {
          const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
          row?.remove();
        });
        recalculateStatusCounts();
        applyFilters();
        updateSelectionUI();
        showSyncToast(`${ids.length} pendiente(s) eliminado(s) (Contactos intactos)`);
      } else {
        alert('No se pudieron eliminar los pendientes seleccionados.');
      }
    } finally {
      btnDeleteSelected.disabled = false;
    }
  });

  // Eliminar todos los pendientes (o los del estatus filtrado) manteniendo contactos intactos
  btnDeleteAll?.addEventListener('click', async () => {
    if (!tbody) return;
    const allRows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));
    const targetRows =
      selectedStatus !== 'ALL'
        ? allRows.filter((r) => r.dataset.rowStatus === selectedStatus)
        : allRows;

    if (targetRows.length === 0) {
      alert('No hay pendientes para eliminar en esta vista.');
      return;
    }

    const scopeLabel =
      selectedStatus !== 'ALL'
        ? `los ${targetRows.length} pendiente(s) del estatus "${selectedStatus}"`
        : `TODOS los ${targetRows.length} pendientes`;

    const confirmed = window.confirm(
      `¿Estás seguro de eliminar ${scopeLabel} de la base de datos D1?\n\n✅ Tu directorio de Contactos se mantendrá 100% intacto.`
    );
    if (!confirmed) return;

    btnDeleteAll.disabled = true;
    try {
      const response = await fetch('/api/pendientes', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          all: true,
          status: selectedStatus !== 'ALL' ? selectedStatus : undefined,
        }),
      });

      if (response.ok) {
        targetRows.forEach((r) => r.remove());
        recalculateStatusCounts();
        applyFilters();
        updateSelectionUI();
        showSyncToast('Pendientes eliminados (Contactos intactos)');
      } else {
        alert('Ocurrió un error al eliminar los pendientes.');
      }
    } finally {
      btnDeleteAll.disabled = false;
    }
  });

  // Clic o Enter sobre cualquier fila de la tabla -> abre el modal (excepto WhatsApp, checkbox o botón eliminar)
  tbody?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-whatsapp-link]')) return;
    if (target.closest('[data-row-checkbox]')) return;

    const deleteBtn = target.closest<HTMLButtonElement>('[data-delete-pendiente]');
    if (deleteBtn) {
      event.stopPropagation();
      const id = Number(deleteBtn.dataset.deletePendiente);
      const name = deleteBtn.dataset.deleteName || `#${id}`;
      if (!id) return;

      const confirmed = window.confirm(
        `¿Deseas eliminar el pendiente de "${name}"?\n\n✅ El contacto se mantendrá intacto en la sección de Contactos.`
      );
      if (!confirmed) return;

      deleteBtn.disabled = true;
      try {
        const response = await fetch(`/api/pendientes?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
          const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
          row?.remove();
          recalculateStatusCounts();
          applyFilters();
          updateSelectionUI();
          showSyncToast(`Pendiente eliminado (Contacto intacto)`);
        } else {
          alert('No se pudo eliminar el pendiente.');
        }
      } finally {
        deleteBtn.disabled = false;
      }
      return;
    }

    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowRecord) return;

    const record = JSON.parse(row.dataset.rowRecord) as ClienteRecord;
    openClientModal(record);
  });

  tbody?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const target = event.target as HTMLElement;
    if (target.closest('[data-whatsapp-link]')) return;
    if (target.closest('[data-row-checkbox]')) return;
    if (target.closest('[data-delete-pendiente]')) return;
    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowRecord) return;

    event.preventDefault();
    const record = JSON.parse(row.dataset.rowRecord) as ClienteRecord;
    openClientModal(record);
  });

  function getTodayFormatted(): string {
    const today = new Date();
    const day = String(today.getDate()).padStart(2, '0');
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const year = String(today.getFullYear()).slice(-2);
    return `${day}/${month}/${year}`;
  }

  function renderSuggestions(query: string) {
    if (!suggestionsBox) return;
    const q = query.toLowerCase().trim();
    if (!q) {
      suggestionsBox.classList.add('hidden');
      suggestionsBox.innerHTML = '';
      return;
    }

    const matches = contactosList
      .filter((c) => {
        const full = `${c.contacto} ${c.telefono} ${c.nombres} ${c.apellidos}`.toLowerCase();
        return full.includes(q);
      })
      .slice(0, 8);

    if (matches.length === 0) {
      suggestionsBox.classList.add('hidden');
      suggestionsBox.innerHTML = '';
      return;
    }

    suggestionsBox.innerHTML = matches
      .map((item) => {
        const details = [];
        if (item.telefono && item.telefono !== '-') details.push(`📞 ${item.telefono}`);
        if (item.numero_pasaporte && item.numero_pasaporte !== '-') details.push(`🛂 ${item.numero_pasaporte}`);
        return `
          <li
            data-suggestion="${encodeURIComponent(JSON.stringify(item))}"
            class="px-3.5 py-2 hover:bg-base-muted cursor-pointer transition flex items-center justify-between gap-2"
          >
            <div class="min-w-0">
              <span class="font-bold text-primary truncate block">${item.contacto}</span>
              ${details.length > 0 ? `<span class="text-[11px] text-primary/70">${details.join(' · ')}</span>` : ''}
            </div>
            <span class="text-[10px] uppercase font-bold text-primary/60 bg-base px-1.5 py-0.5 rounded border border-base-border shrink-0">Elegir</span>
          </li>
        `;
      })
      .join('');

    suggestionsBox.classList.remove('hidden');
  }

  fContacto?.addEventListener('input', () => {
    renderSuggestions(fContacto.value);
  });

  suggestionsBox?.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLLIElement>('li[data-suggestion]');
    if (!li || !li.dataset.suggestion) return;
    try {
      const item = JSON.parse(decodeURIComponent(li.dataset.suggestion)) as ContactoRecord;
      if (fContacto) fContacto.value = item.contacto;
      if (
        fApellidos &&
        (!fApellidos.value || fApellidos.value === '-') &&
        item.apellidos &&
        item.apellidos !== '-'
      ) {
        fApellidos.value = item.apellidos;
      }
    } catch {}
    suggestionsBox.classList.add('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!fContacto?.contains(e.target as Node) && !suggestionsBox?.contains(e.target as Node)) {
      suggestionsBox?.classList.add('hidden');
    }
  });

  btnOpenNew?.addEventListener('click', () => {
    if (!modal || !form) return;
    form.reset();
    if (fId) fId.value = '';
    if (fFecha) fFecha.value = getTodayFormatted();
    if (fCheckin) fCheckin.value = '-';
    if (fAerolinea) fAerolinea.value = '';
    if (fLocalizador) fLocalizador.value = '';
    if (fApellidos) fApellidos.value = '';
    if (fMonto) fMonto.value = '';
    if (fMontoMoneda) fMontoMoneda.value = 'Fls';
    if (fAbono) fAbono.value = '';
    if (fAbonoMoneda) fAbonoMoneda.value = 'Fls';
    if (fGanancia) fGanancia.value = '';
    if (fGananciaMoneda) fGananciaMoneda.value = 'Fls';
    if (fStatus && fStatus.options.length > 0) {
      fStatus.selectedIndex = 0;
    }
    updateModalFieldVisibility();
    if (modalTitle) modalTitle.textContent = 'Cliente';
    if (modalSubtitle) modalSubtitle.textContent = 'Ingresa los datos para registrar en Cloudflare D1';
    if (btnDeleteModal) btnDeleteModal.classList.add('hidden');
    if (btnSubmitModal) btnSubmitModal.textContent = 'Crear Pendiente';
    modal.showModal();
    fContacto?.focus();
  });

  btnCloseModal?.addEventListener('click', () => modal?.close());
  btnCancelModal?.addEventListener('click', () => modal?.close());

  if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
    const outside = (e: PointerEvent, d: HTMLDialogElement) => {
      const r = d.getBoundingClientRect();
      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    };
    let pressedOutside = false;
    modal.addEventListener('pointerdown', (e) => {
      pressedOutside = outside(e, modal);
    });
    modal.addEventListener('pointerup', (e) => {
      if (pressedOutside && outside(e, modal)) modal.close();
    });
  }

  // Eliminar pendiente desde dentro del modal (manteniendo el contacto intacto)
  btnDeleteModal?.addEventListener('click', async () => {
    const idVal = fId?.value?.trim();
    if (!idVal) return;
    const id = Number(idVal);
    const nombre = fContacto?.value?.trim() || `#${id}`;

    if (
      !window.confirm(
        `¿Estás seguro de eliminar el pendiente de "${nombre}" de la base de datos D1?\n\n✅ El contacto en el directorio de Contactos se mantendrá intacto.`
      )
    ) {
      return;
    }

    btnDeleteModal.disabled = true;
    try {
      const response = await fetch(`/api/pendientes?id=${id}`, { method: 'DELETE' });
      if (response.ok) {
        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
        row?.remove();
        recalculateStatusCounts();
        applyFilters();
        updateSelectionUI();
        modal?.close();
        showSyncToast(`Pendiente #${id} eliminado (Contacto intacto)`);
      }
    } finally {
      btnDeleteModal.disabled = false;
    }
  });

  let pendingSavePayload: any = null;

  function openQuickContactoModal(contacto: string, apellidosDefault?: string) {
    if (!modalQuickContacto || !formQuickContacto) return;
    formQuickContacto.reset();

    if (quickFContacto) quickFContacto.value = contacto;
    const parsed = parseContactoInitial(contacto);
    if (quickFTelefono) quickFTelefono.value = parsed.telefono !== '-' ? parsed.telefono : '';
    if (quickFEmail) quickFEmail.value = '';
    if (quickFNombres) quickFNombres.value = parsed.nombres !== '-' ? parsed.nombres : '';
    if (quickFApellidos) {
      quickFApellidos.value =
        apellidosDefault && apellidosDefault !== '-'
          ? apellidosDefault
          : (parsed.apellidos !== '-' ? parsed.apellidos : '');
    }
    if (quickFNacimiento) quickFNacimiento.value = '';
    if (quickFGenero) quickFGenero.value = '-';
    if (quickFPasaporte) quickFPasaporte.value = '';
    if (quickFNacionalidad) quickFNacionalidad.value = '';
    if (quickFEmision) quickFEmision.value = '';
    if (quickFVencimiento) quickFVencimiento.value = '';

    // Cerrar el modal de pendiente primero para evitar conflicto de dos <dialog> modales simultáneos
    modal?.close();
    modalQuickContacto.showModal();
    quickFTelefono?.focus();
  }

  async function executeSavePendiente(payload: any) {
    if (btnSubmitModal) {
      btnSubmitModal.disabled = true;
      btnSubmitModal.textContent = 'Guardando...';
    }

    try {
      const method = payload.id ? 'PATCH' : 'POST';
      const response = await fetch('/api/pendientes', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as { ok?: boolean; data?: ClienteRecord; error?: string };

      if (response.ok && result.ok && result.data) {
        const updated = result.data;

        if (!payload.id) {
          modal?.close();
          window.location.reload();
          return;
        }

        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${updated.id}"]`);
        const cfg = STATUS_CONFIGS[updated.status as keyof typeof STATUS_CONFIGS];

        if (row) {
          row.dataset.rowStatus = updated.status;
          row.dataset.rowName = updated.contacto;
          row.dataset.rowRecord = JSON.stringify(updated);

          const cellContacto = row.querySelector<HTMLElement>(`[data-cell-contacto="${updated.id}"]`);
          const badge = row.querySelector<HTMLElement>(`[data-badge-for="${updated.id}"]`);
          const dot = row.querySelector<HTMLElement>(`[data-dot-for="${updated.id}"]`);
          const label = row.querySelector<HTMLElement>(`[data-label-for="${updated.id}"]`);
          const cellFecha = row.querySelector<HTMLElement>(`[data-cell-fecha="${updated.id}"]`);
          const cellVuelo = row.querySelector<HTMLElement>(`[data-cell-vuelo="${updated.id}"]`);
          const cellObs = row.querySelector<HTMLElement>(`[data-cell-observacion="${updated.id}"]`);
          const cellPrecio = row.querySelector<HTMLElement>(`[data-cell-precio="${updated.id}"]`);

          const nameSpan = row.querySelector<HTMLElement>(`[data-name-for="${updated.id}"]`);
          const waAnchor = row.querySelector<HTMLAnchorElement>(`[data-wa-for="${updated.id}"]`);
          if (nameSpan) {
            nameSpan.textContent = updated.contacto;
          } else if (cellContacto) {
            cellContacto.textContent = updated.contacto;
          }
          if (waAnchor) {
            const newWa = buildWhatsAppDynamicLink(updated.contacto, undefined, contactosList, updated.solicitud_vuelo);
            waAnchor.href = newWa.url;
            waAnchor.title = newWa.label;
            waAnchor.setAttribute('aria-label', newWa.label);
          }
          if (badge) {
            badge.className = `inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-bold w-fit ${
              cfg?.badgeClass || ''
            }`;
            if (updated.status_color) {
              badge.style.backgroundColor = `${updated.status_color}18`;
              badge.style.color = updated.status_color;
              badge.style.borderColor = `${updated.status_color}55`;
            }
          }
          if (dot) {
            dot.className = `h-2.5 w-2.5 shrink-0 rounded-full ${cfg?.dotClass || ''}`;
            if (updated.status_color) {
              dot.style.backgroundColor = updated.status_color;
            }
          }
          if (label) {
            label.textContent = updated.status;
          }
          if (cellFecha) cellFecha.textContent = updated.fecha_gestion;
          const vueloTextEl = row.querySelector<HTMLElement>(`[data-vuelo-text="${updated.id}"]`);
          if (vueloTextEl) {
            vueloTextEl.textContent = updated.solicitud_vuelo;
          } else if (cellVuelo) {
            cellVuelo.textContent = updated.solicitud_vuelo;
          }
          if (cellObs) cellObs.textContent = updated.observacion;
          if (cellPrecio) {
            const parts: string[] = [];
            if (updated.monto && updated.monto !== '-') {
              parts.push(`<span class="text-secondary">${updated.monto}</span>`);
            } else {
              parts.push(`<span class="text-primary/40 font-normal">-</span>`);
            }
            if (updated.abono && updated.abono !== '-') {
              parts.push(`<span class="text-[11px] font-bold text-amber-700">Abono: ${updated.abono}</span>`);
            }
            if (updated.ganancia && updated.ganancia !== '-') {
              parts.push(`<span class="text-[11px] font-bold text-emerald-700">Ganancia: ${updated.ganancia}</span>`);
            }
            cellPrecio.innerHTML = `<div class="flex flex-col gap-0.5">${parts.join('')}</div>`;
          }
        }

        recalculateStatusCounts();
        applyFilters();
        modal?.close();
        showSyncToast(`Cambios guardados en D1 (#${updated.id})`);
      } else {
        alert(result.error || 'Error al guardar el pendiente en D1.');
      }
    } catch {
      alert('Error de conexión al guardar el pendiente.');
    } finally {
      if (btnSubmitModal) {
        btnSubmitModal.disabled = false;
        btnSubmitModal.textContent = payload.id ? 'Guardar Cambios' : 'Crear Pendiente';
      }
    }
  }

  // Eventos Modal Quick Contacto
  formQuickContacto?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btnSubmitQuickContacto) return;

    const contactoName = quickFContacto?.value?.trim() || pendingSavePayload?.contacto || '';
    if (!contactoName) {
      alert('El nombre del cliente/contacto es obligatorio.');
      quickFContacto?.focus();
      return;
    }

    const newContactData = {
      contacto: contactoName,
      telefono: quickFTelefono?.value?.trim() || '-',
      email: quickFEmail?.value?.trim() || '-',
      nombres: quickFNombres?.value?.trim() || '-',
      apellidos: quickFApellidos?.value?.trim() || '-',
      fecha_nacimiento: quickFNacimiento?.value?.trim() || '-',
      genero: quickFGenero?.value || '-',
      numero_pasaporte: quickFPasaporte?.value?.trim() || '-',
      nacionalidad_pasaporte: quickFNacionalidad?.value?.trim() || '-',
      fecha_emision_pasaporte: quickFEmision?.value?.trim() || '-',
      fecha_vencimiento_pasaporte: quickFVencimiento?.value?.trim() || '-',
    };

    btnSubmitQuickContacto.disabled = true;
    btnSubmitQuickContacto.textContent = 'Guardando contacto...';

    try {
      const res = await fetch('/api/contactos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newContactData),
      });

      const json = (await res.json()) as { ok?: boolean; data?: ContactoRecord; error?: string };

      if (!res.ok || !json.ok || !json.data) {
        alert(json.error || 'Error al guardar el contacto en D1.');
        btnSubmitQuickContacto.disabled = false;
        btnSubmitQuickContacto.textContent = 'Guardar Contacto y Pendiente';
        return;
      }

      const savedContact = json.data;
      const existingIdx = contactosList.findIndex(
        (c) =>
          c.id === savedContact.id ||
          c.contacto.trim().toLowerCase() === savedContact.contacto.trim().toLowerCase()
      );
      if (existingIdx >= 0) {
        contactosList[existingIdx] = savedContact;
      } else {
        contactosList.push(savedContact);
      }

      if (pendingSavePayload) {
        pendingSavePayload.contacto = savedContact.contacto || contactoName;
        if (
          newContactData.apellidos !== '-' &&
          (!pendingSavePayload.apellidos || pendingSavePayload.apellidos === '-')
        ) {
          pendingSavePayload.apellidos = newContactData.apellidos;
          const codeParts: string[] = [];
          if (pendingSavePayload.aerolinea && pendingSavePayload.aerolinea !== '-') {
            codeParts.push(pendingSavePayload.aerolinea);
          }
          if (pendingSavePayload.localizador && pendingSavePayload.localizador !== '-') {
            codeParts.push(pendingSavePayload.localizador);
          }
          const baseCode = codeParts.join(' | ');
          pendingSavePayload.codigo = baseCode
            ? `${baseCode} / ${newContactData.apellidos}`
            : newContactData.apellidos;
        }
      }
    } catch {
      alert('Error de conexión al guardar el contacto.');
      btnSubmitQuickContacto.disabled = false;
      btnSubmitQuickContacto.textContent = 'Guardar Contacto y Pendiente';
      return;
    }

    btnSubmitQuickContacto.disabled = false;
    btnSubmitQuickContacto.textContent = 'Guardar Contacto y Pendiente';
    modalQuickContacto?.close();

    if (pendingSavePayload) {
      const p = pendingSavePayload;
      pendingSavePayload = null;
      await executeSavePendiente(p);
    }
  });

  btnSkipQuickContacto?.addEventListener('click', async () => {
    modalQuickContacto?.close();
    if (pendingSavePayload) {
      const p = pendingSavePayload;
      pendingSavePayload = null;
      await executeSavePendiente(p);
    }
  });

  btnCancelQuickContacto?.addEventListener('click', () => {
    modalQuickContacto?.close();
    if (pendingSavePayload) {
      modal?.showModal();
    }
  });

  btnCloseModalQuickContacto?.addEventListener('click', () => {
    modalQuickContacto?.close();
    if (pendingSavePayload) {
      modal?.showModal();
    }
  });

  // Guardar Cambios o Crear Cliente en Cloudflare D1
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !btnSubmitModal) return;

    const idVal = fId?.value?.trim();
    const contacto = fContacto?.value?.trim();
    const status = fStatus?.value?.trim();
    const fecha = fFecha?.value?.trim() || '-';
    const solicitud = fSolicitud?.value?.trim() || '-';
    const monto = combineAmountAndCurrency(fMonto?.value, fMontoMoneda?.value);
    const abono = combineAmountAndCurrency(fAbono?.value, fAbonoMoneda?.value);
    const ganancia = combineAmountAndCurrency(fGanancia?.value, fGananciaMoneda?.value);
    const observacion = fObservacion?.value?.trim() || '-';
    const aerolinea = fAerolinea?.value?.trim() || '-';
    const localizador = fLocalizador?.value?.trim() || '-';
    const apellidos = fApellidos?.value?.trim() || '-';
    const checkin = fCheckin?.value?.trim() || '-';

    if (!contacto || !status) {
      alert('Por favor completa los campos obligatorios: Cliente y Estatus.');
      return;
    }

    let codigo = '-';
    const codeParts: string[] = [];
    if (aerolinea && aerolinea !== '-') codeParts.push(aerolinea);
    if (localizador && localizador !== '-') codeParts.push(localizador);
    let baseCode = codeParts.join(' | ');

    if (apellidos && apellidos !== '-') {
      codigo = baseCode ? `${baseCode} / ${apellidos}` : apellidos;
    } else if (baseCode) {
      codigo = baseCode;
    }

    const payload = {
      ...(idVal ? { id: Number(idVal) } : {}),
      contacto,
      status,
      fecha_gestion: fecha,
      solicitud_vuelo: solicitud,
      monto,
      abono,
      ganancia,
      observacion,
      aerolinea,
      localizador,
      apellidos,
      checkin,
      codigo,
    };

    // Validar si el contacto ya existe en la lista de contactos
    const cleanContacto = contacto.trim().toLowerCase();
    const existsInContactos = contactosList.some(
      (c) => c.contacto.trim().toLowerCase() === cleanContacto
    );

    if (!existsInContactos) {
      pendingSavePayload = payload;
      openQuickContactoModal(contacto, apellidos);
      return;
    }

    await executeSavePendiente(payload);
  });

  // Inicializar vista y conteo de Pendientes de Hoy al cargar
  applyFilters();
  updateSelectionUI();
</script>
