---
import { NAV_ITEMS } from '@/constants/site';

interface Props {
  activeTab?: 'pendientes' | 'pagos' | 'contactos' | 'estatus';
}

const { activeTab = 'pendientes' } = Astro.props;
---

<header class="bg-base border-b border-base-border shadow-xs sticky top-0 z-30">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    <div class="flex items-center justify-between gap-4">
      <!-- Logo a la izquierda -->
      <a href="/" class="flex items-center gap-3 focus:outline-none group" aria-label="Global Travel CW">
        <img
          src="/img/logo.webp"
          alt="Global Travel CW"
          class="h-10 sm:h-12 md:h-14 w-auto object-contain transition group-hover:opacity-90"
          loading="eager"
        />
      </a>

      <!-- Menú a la derecha (Contactos, Pendientes, Pagos y Estatus) -->
      <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Menú principal">
        {
          NAV_ITEMS.map((item) => {
            const isActive = activeTab === item.id;
            return (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-lg text-sm transition cursor-pointer ${
                  isActive
                    ? 'bg-primary text-base font-bold shadow-xs hover:bg-primary-light'
                    : 'text-primary/80 hover:text-primary hover:bg-base-muted font-semibold'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</header>
