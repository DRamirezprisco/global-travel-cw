---
import { NAV_ITEMS } from '@/constants/site';

interface Props {
  activeTab?: 'pendientes' | 'pendientes-hoy' | 'pagos' | 'contactos' | 'notas' | 'estatus';
}

const { activeTab = 'pendientes' } = Astro.props;
---

<header class="shrink-0 bg-base border-b border-base-border shadow-xs z-30">
  <div class="max-w-[1600px] mx-auto px-2.5 sm:px-6 lg:px-8 py-1.5 sm:py-2.5">
    <div class="flex items-center justify-between gap-1.5 sm:gap-4 flex-nowrap">
      <!-- Logo a la izquierda -->
      <a href="/" class="flex items-center gap-1.5 focus:outline-none group shrink-0" aria-label="Global Travel CW">
        <img
          src="/img/logo.webp"
          alt="Global Travel CW"
          class="h-7 sm:h-10 md:h-12 w-auto object-contain transition group-hover:opacity-90"
          loading="eager"
        />
      </a>

      <!-- Menú a la derecha en una sola fila al lado del logo -->
      <nav class="flex items-center gap-1 sm:gap-1.5 ml-auto overflow-x-auto no-scrollbar flex-nowrap py-0.5" aria-label="Menú principal">
        {
          NAV_ITEMS.map((item) => {
            const isActive = activeTab === item.id;
            return (
              <a
                href={item.href}
                class={`px-2 py-1 sm:px-3 sm:py-1.5 md:px-4 md:py-2 rounded-md sm:rounded-lg text-[11px] sm:text-xs md:text-sm font-bold whitespace-nowrap shrink-0 transition cursor-pointer ${
                  isActive
                    ? 'bg-primary text-base shadow-xs hover:bg-primary-light'
                    : 'text-primary/80 hover:text-primary hover:bg-base-muted'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</header>

<script>
  import {
    downloadOperationalReportExcel,
    downloadPendientesReportPdf,
    downloadCobranzasReportPdf,
  } from '@/utils/reportExporter';

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;

    const excelBtn = target.closest<HTMLButtonElement>('[data-export-excel]');
    if (excelBtn) {
      event.preventDefault();
      if (excelBtn.disabled) return;
      const label = excelBtn.querySelector<HTMLElement>('[data-export-excel-label]');
      const prevText = label?.textContent || 'Excel';
      excelBtn.disabled = true;
      if (label) label.textContent = 'Generando...';
      try {
        await downloadOperationalReportExcel();
      } catch (err) {
        alert(
          err instanceof Error
            ? err.message
            : 'Ocurrió un error al generar el reporte en Excel.'
        );
      } finally {
        excelBtn.disabled = false;
        if (label) label.textContent = prevText;
      }
      return;
    }

    const pdfBtn = target.closest<HTMLButtonElement>('[data-export-pdf]');
    if (pdfBtn) {
      event.preventDefault();
      if (pdfBtn.disabled) return;
      const reportType = (pdfBtn.dataset.exportPdf || '').toLowerCase();
      const label = pdfBtn.querySelector<HTMLElement>('[data-export-pdf-label]');
      const prevText = label?.textContent || 'PDF';
      pdfBtn.disabled = true;
      if (label) label.textContent = 'Generando...';
      try {
        if (reportType === 'cobranzas' || reportType === 'pagos') {
          await downloadCobranzasReportPdf();
        } else {
          await downloadPendientesReportPdf();
        }
      } catch (err) {
        alert(
          err instanceof Error
            ? err.message
            : 'Ocurrió un error al generar el reporte en PDF.'
        );
      } finally {
        pdfBtn.disabled = false;
        if (label) label.textContent = prevText;
      }
    }
  });
</script>
