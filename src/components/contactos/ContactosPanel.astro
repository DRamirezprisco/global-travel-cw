</dialog>

<script>
  import type { ContactoRecord, PendienteRecord } from '@/types';
  import { createMidnightDate, evaluatePendienteForHoy } from '@/utils/flightDateHelpers';
  import { buildWhatsAppDynamicLink } from '@/utils/pagoHelpers';

  let selectedFilter = 'ALL';
  const tbody = document.querySelector<HTMLTableSectionElement>('#contactos-tbody');
  const syncToast = document.querySelector<HTMLElement>('#d1-sync-toast');
  const btnNuevoContacto = document.querySelector<HTMLButtonElement>('#btn-nuevo-contacto');

  const FILTER_LABELS: Record<string, string> = {
    ALL: 'Filtros',
    SIN_NOMBRE: 'Filtros: Sin Nombre',
    CON_TEL: 'Filtros: Con Teléfono',
    SIN_TEL: 'Filtros: Sin Teléfono',
    CON_PAS: 'Filtros: Con Pasaporte',
    SIN_PAS: 'Filtros: Sin Pasaporte',
    CON_EMAIL: 'Filtros: Con Email',
    TIPO_VIP: 'Filtros: VIP',
    TIPO_SECUNDARIO: 'Filtros: Secundario',
    TIPO_PAPEAMENTO: 'Filtros: Papeamento/Ingles',
    TIPO_MENOR: 'Filtros: Menor importancia',
  };

  function getTipoClienteBadgeClass(tipo?: string): string {
    switch ((tipo || '-').trim()) {
      case 'VIP':
        return 'bg-emerald-800 text-white border border-emerald-950';
      case 'Secundario':
        return 'bg-purple-600 text-white border border-purple-700';
      case 'Papeamento/Ingles':
        return 'bg-blue-950 text-white border border-blue-950';
      case 'Menor importancia':
        return 'bg-slate-200 text-slate-700 border border-slate-300';
      default:
        return 'hidden';
    }
  }

  function isPhoneLikeText(val: string | undefined | null): boolean {
    const s = (val || '').trim();
    if (!s || s === '-') return false;
    return /^[\d\s\+\-\(\)\.]+$/.test(s);
  }

  function isContactoSinNombre(c: Partial<ContactoRecord>): boolean {
    const contactoStr = (c.contacto || '').trim();
    const telStr = (c.telefono || '').trim();
    const nombresStr = (c.nombres || '').trim();
    const apellidosStr = (c.apellidos || '').trim();

    const hasValidNombres = Boolean(nombresStr && nombresStr !== '-' && !isPhoneLikeText(nombresStr));
    const hasValidApellidos = Boolean(apellidosStr && apellidosStr !== '-' && !isPhoneLikeText(apellidosStr));

    if (!contactoStr || contactoStr === '-' || isPhoneLikeText(contactoStr)) return true;
    if (telStr && telStr !== '-' && contactoStr.toLowerCase() === telStr.toLowerCase()) return true;

    const contactoWithoutPhone = telStr && telStr !== '-' ? contactoStr.replace(telStr, '').trim() : contactoStr;
    const hasLettersInContacto = /[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ]{2,}/.test(contactoWithoutPhone);
    if (!hasLettersInContacto && !hasValidNombres && !hasValidApellidos) return true;

    return false;
  }

  // Modal Contacto
  const modal = document.querySelector<HTMLDialogElement>('#modal-contacto');
  const form = document.querySelector<HTMLFormElement>('#form-contacto');
  const modalTitle = document.querySelector<HTMLElement>('#modal-contacto-title');
  const modalSubtitle = document.querySelector<HTMLElement>('#modal-contacto-subtitle');
  const btnCloseModal = document.querySelector<HTMLButtonElement>('#btn-close-modal-contacto');
  const btnCancelModal = document.querySelector<HTMLButtonElement>('#btn-cancel-modal-contacto');
  const btnDeleteModal = document.querySelector<HTMLButtonElement>('#btn-delete-modal-contacto');
  const btnSubmitModal = document.querySelector<HTMLButtonElement>('#btn-submit-modal-contacto');

  const fId = document.querySelector<HTMLInputElement>('#field-contacto-id');
  const fContacto = document.querySelector<HTMLInputElement>('#field-contacto-contacto');
  const fTelefono = document.querySelector<HTMLInputElement>('#field-contacto-telefono');
  const fEmail = document.querySelector<HTMLInputElement>('#field-contacto-email');
  const fNombres = document.querySelector<HTMLInputElement>('#field-contacto-nombres');
  const fApellidos = document.querySelector<HTMLInputElement>('#field-contacto-apellidos');
  const fNacimiento = document.querySelector<HTMLInputElement>('#field-contacto-nacimiento');
  const fGenero = document.querySelector<HTMLSelectElement>('#field-contacto-genero');
  const fTipoCliente = document.querySelector<HTMLSelectElement>('#field-contacto-tipo-cliente');
  const previewBadgeTipoCliente = document.querySelector<HTMLElement>('#preview-badge-tipo-cliente');
  const fPasaporte = document.querySelector<HTMLInputElement>('#field-contacto-pasaporte');
  const fNacionalidad = document.querySelector<HTMLInputElement>('#field-contacto-nacionalidad');
  const fEmision = document.querySelector<HTMLInputElement>('#field-contacto-emision');
  const fVencimiento = document.querySelector<HTMLInputElement>('#field-contacto-vencimiento');

  function updateModalTipoBadgePreview() {
    if (!previewBadgeTipoCliente || !fTipoCliente) return;
    const val = (fTipoCliente.value || '-').trim();
    if (!val || val === '-') {
      previewBadgeTipoCliente.textContent = '';
      previewBadgeTipoCliente.className = 'hidden items-center rounded-md px-2 py-0.5 text-[10px] font-extrabold tracking-wide leading-tight';
      return;
    }
    previewBadgeTipoCliente.textContent = val;
    previewBadgeTipoCliente.className = `inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-extrabold tracking-wide leading-tight ${getTipoClienteBadgeClass(val)}`;
  }

  fTipoCliente?.addEventListener('change', updateModalTipoBadgePreview);

  function showSyncToast(text = 'Guardado en D1') {
    if (!syncToast) return;
    syncToast.textContent = text;
    syncToast.classList.remove('hidden');
    window.setTimeout(() => {
      syncToast.classList.add('hidden');
    }, 2600);
  }

  function applyFilters() {
    const currentTbody = document.querySelector<HTMLTableSectionElement>('#contactos-tbody');
    if (!currentTbody) return;

    const currentSearchInput = document.querySelector<HTMLInputElement>('#input-search-contactos');
    const currentBtnHamburger = document.querySelector<HTMLButtonElement>('#btn-toggle-hamburger-contactos');
    const currentLabelHamburger = document.querySelector<HTMLElement>('#label-hamburger-contactos');
    const currentBadgeHamburger = document.querySelector<HTMLElement>('#badge-hamburger-contactos');
    const currentPanelFiltros = document.querySelector<HTMLElement>('#panel-filtros-contactos');
    const emptyFilterRow = document.querySelector<HTMLTableRowElement>('#contactos-empty-filter-row');

    const query = (currentSearchInput?.value ?? '').toLowerCase().trim();
    const rows = Array.from(currentTbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));

    let visibleCount = 0;

    for (const row of rows) {
      let rec: Partial<ContactoRecord> | null = null;
      const recordStr = row.dataset.rowRecord || '';
      if (recordStr) {
        try {
          rec = JSON.parse(recordStr) as ContactoRecord;
        } catch {
          rec = null;
        }
      }

      const fullSearch = rec
        ? `${rec.contacto || ''} ${rec.telefono || ''} ${rec.email || ''} ${rec.nombres || ''} ${rec.apellidos || ''} ${rec.numero_pasaporte || ''} ${rec.nacionalidad_pasaporte || ''} ${rec.tipo_cliente || ''}`.toLowerCase()
        : (row.textContent || '').toLowerCase();
      const matchesQuery = !query || fullSearch.includes(query);

      const hasTel =
        row.dataset.rowHasTel !== undefined
          ? row.dataset.rowHasTel === '1'
          : Boolean(rec?.telefono && rec.telefono.trim() !== '-' && rec.telefono.trim() !== '');
      const sinNombre =
        rec !== null
          ? isContactoSinNombre(rec)
          : row.dataset.rowSinNombre === '1';
      const hasPas =
        row.dataset.rowHasPas !== undefined
          ? row.dataset.rowHasPas === '1'
          : Boolean(rec?.numero_pasaporte && rec.numero_pasaporte.trim() !== '-' && rec.numero_pasaporte.trim() !== '');
      const hasEmail =
        row.dataset.rowHasEmail !== undefined
          ? row.dataset.rowHasEmail === '1'
          : Boolean(rec?.email && rec.email.trim() !== '-' && rec.email.trim() !== '');
      const tipoCliente = (
        row.dataset.rowTipoCliente ||
        rec?.tipo_cliente ||
        '-'
      ).trim();

      let matchesFilter = true;
      if (selectedFilter === 'CON_TEL') {
        matchesFilter = hasTel;
      } else if (selectedFilter === 'SIN_TEL') {
        matchesFilter = !hasTel;
      } else if (selectedFilter === 'SIN_NOMBRE') {
        matchesFilter = sinNombre;
      } else if (selectedFilter === 'CON_PAS') {
        matchesFilter = hasPas;
      } else if (selectedFilter === 'SIN_PAS') {
        matchesFilter = !hasPas;
      } else if (selectedFilter === 'CON_EMAIL') {
        matchesFilter = hasEmail;
      } else if (selectedFilter === 'TIPO_VIP') {
        matchesFilter = tipoCliente === 'VIP';
      } else if (selectedFilter === 'TIPO_SECUNDARIO') {
        matchesFilter = tipoCliente === 'Secundario';
      } else if (selectedFilter === 'TIPO_PAPEAMENTO') {
        matchesFilter = tipoCliente === 'Papeamento/Ingles';
      } else if (selectedFilter === 'TIPO_MENOR') {
        matchesFilter = tipoCliente === 'Menor importancia';
      }

      if (matchesQuery && matchesFilter) {
        row.style.display = '';
        row.classList.remove('hidden');
        row.hidden = false;
        visibleCount++;
      } else {
        row.style.display = 'none';
        row.classList.add('hidden');
        row.hidden = true;
      }
    }

    if (emptyFilterRow) {
      if (visibleCount === 0) {
        emptyFilterRow.style.display = '';
        emptyFilterRow.classList.remove('hidden');
        emptyFilterRow.hidden = false;
      } else {
        emptyFilterRow.style.display = 'none';
        emptyFilterRow.classList.add('hidden');
        emptyFilterRow.hidden = true;
      }
    }

    document.querySelectorAll<HTMLButtonElement>('[data-filter-pill]').forEach((pill) => {
      if (pill.dataset.filterPill === selectedFilter) {
        pill.classList.add('ring-2', 'ring-primary', 'scale-[1.02]');
      } else {
        pill.classList.remove('ring-2', 'ring-primary', 'scale-[1.02]');
      }
    });

    const isFilterActive = selectedFilter !== 'ALL';
    if (currentLabelHamburger) {
      currentLabelHamburger.textContent = FILTER_LABELS[selectedFilter] || 'Filtros';
    }
    if (currentBadgeHamburger) {
      if (isFilterActive) {
        currentBadgeHamburger.textContent = '1';
        currentBadgeHamburger.classList.remove('hidden');
        currentBadgeHamburger.classList.add('inline-flex');
      } else {
        currentBadgeHamburger.classList.add('hidden');
        currentBadgeHamburger.classList.remove('inline-flex');
      }
    }

    if (currentBtnHamburger) {
      const isMenuOpen = currentPanelFiltros && !currentPanelFiltros.classList.contains('hidden');
      if (isFilterActive || isMenuOpen) {
        currentBtnHamburger.classList.remove('bg-base-muted', 'text-primary', 'border-primary/30');
        currentBtnHamburger.classList.add('bg-primary', 'text-base', 'border-primary', 'ring-2', 'ring-primary/25');
      } else {
        currentBtnHamburger.classList.add('bg-base-muted', 'text-primary', 'border-primary/30');
        currentBtnHamburger.classList.remove('bg-primary', 'text-base', 'border-primary', 'ring-2', 'ring-primary/25');
      }
    }
  }

  function recalculateStats() {
    const currentTbody = document.querySelector<HTMLTableSectionElement>('#contactos-tbody');
    if (!currentTbody) return;
    const rows = Array.from(currentTbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));
    let telCount = 0;
    let sinNombreCount = 0;
    let pasCount = 0;
    let emailCount = 0;
    let vipCount = 0;
    let secundarioCount = 0;
    let papeamentoCount = 0;
    let menorCount = 0;

    for (const row of rows) {
      if (row.dataset.rowHasTel === '1') telCount++;
      if (row.dataset.rowSinNombre === '1') sinNombreCount++;
      if (row.dataset.rowHasPas === '1') pasCount++;
      if (row.dataset.rowHasEmail === '1') emailCount++;
      const tc = (row.dataset.rowTipoCliente || '-').trim();
      if (tc === 'VIP') vipCount++;
      else if (tc === 'Secundario') secundarioCount++;
      else if (tc === 'Papeamento/Ingles') papeamentoCount++;
      else if (tc === 'Menor importancia') menorCount++;
    }

    const sinTelCount = rows.length - telCount;
    const sinPasCount = rows.length - pasCount;
    const statTotal = document.querySelector('#stat-total');
    const menuStatTotal = document.querySelector('#menu-stat-total');
    const statTel = document.querySelector('#stat-tel');
    const menuStatTel = document.querySelector('#menu-stat-tel');
    const statSinTel = document.querySelector('#stat-sin-tel');
    const btnStatSinTel = document.querySelector('#btn-stat-sin-tel');
    const statSinNombre = document.querySelector('#stat-sin-nombre');
    const btnStatSinNombre = document.querySelector('#btn-stat-sin-nombre');
    const statPas = document.querySelector('#stat-pas');
    const menuStatPas = document.querySelector('#menu-stat-pas');
    const statSinPas = document.querySelector('#stat-sin-pas');
    const menuStatSinPas = document.querySelector('#menu-stat-sin-pas');
    const statEmail = document.querySelector('#stat-email');
    const menuStatEmail = document.querySelector('#menu-stat-email');
    const menuStatVip = document.querySelector('#menu-stat-vip');
    const menuStatSecundario = document.querySelector('#menu-stat-secundario');
    const menuStatPapeamento = document.querySelector('#menu-stat-papeamento');
    const menuStatMenor = document.querySelector('#menu-stat-menor');

    if (statTotal) statTotal.textContent = String(rows.length);
    if (menuStatTotal) menuStatTotal.textContent = String(rows.length);
    if (statTel) statTel.textContent = String(telCount);
    if (menuStatTel) menuStatTel.textContent = String(telCount);
    if (statSinTel) statSinTel.textContent = String(sinTelCount);
    if (btnStatSinTel) btnStatSinTel.textContent = String(sinTelCount);
    if (statSinNombre) statSinNombre.textContent = String(sinNombreCount);
    if (btnStatSinNombre) btnStatSinNombre.textContent = String(sinNombreCount);
    if (statPas) statPas.textContent = String(pasCount);
    if (menuStatPas) menuStatPas.textContent = String(pasCount);
    if (statSinPas) statSinPas.textContent = String(sinPasCount);
    if (menuStatSinPas) menuStatSinPas.textContent = String(sinPasCount);
    if (statEmail) statEmail.textContent = String(emailCount);
    if (menuStatEmail) menuStatEmail.textContent = String(emailCount);
    if (menuStatVip) menuStatVip.textContent = String(vipCount);
    if (menuStatSecundario) menuStatSecundario.textContent = String(secundarioCount);
    if (menuStatPapeamento) menuStatPapeamento.textContent = String(papeamentoCount);
    if (menuStatMenor) menuStatMenor.textContent = String(menorCount);
  }

  function openContactoModal(record?: ContactoRecord) {
    if (!modal || !form) return;

    if (record) {
      if (modalTitle) modalTitle.textContent = `Ficha de Contacto #${record.id}`;
      if (modalSubtitle) modalSubtitle.textContent = `Actualización de datos en Cloudflare D1`;
      if (fId) fId.value = String(record.id);
      if (fContacto) fContacto.value = record.contacto;
      if (fTelefono) fTelefono.value = record.telefono === '-' ? '' : record.telefono;
      if (fEmail) fEmail.value = record.email === '-' ? '' : record.email;
      if (fNombres) fNombres.value = record.nombres === '-' ? '' : record.nombres;
      if (fApellidos) fApellidos.value = record.apellidos === '-' ? '' : record.apellidos;
      if (fNacimiento) fNacimiento.value = record.fecha_nacimiento === '-' ? '' : record.fecha_nacimiento;
      if (fGenero) fGenero.value = record.genero || '-';
      if (fTipoCliente) fTipoCliente.value = record.tipo_cliente || '-';
      if (fPasaporte) fPasaporte.value = record.numero_pasaporte === '-' ? '' : record.numero_pasaporte;
      if (fNacionalidad) fNacionalidad.value = record.nacionalidad_pasaporte === '-' ? '' : record.nacionalidad_pasaporte;
      if (fEmision) fEmision.value = record.fecha_emision_pasaporte === '-' ? '' : record.fecha_emision_pasaporte;
      if (fVencimiento) fVencimiento.value = record.fecha_vencimiento_pasaporte === '-' ? '' : record.fecha_vencimiento_pasaporte;

      if (btnDeleteModal) btnDeleteModal.classList.remove('hidden');
      if (btnSubmitModal) btnSubmitModal.textContent = 'Guardar Cambios';
    } else {
      form.reset();
      if (modalTitle) modalTitle.textContent = 'Nuevo Contacto';
      if (modalSubtitle) modalSubtitle.textContent = 'Ingresa los datos para registrar en el directorio de clientes';
      if (fId) fId.value = '';
      if (fTipoCliente) fTipoCliente.value = '-';
      if (btnDeleteModal) btnDeleteModal.classList.add('hidden');
      if (btnSubmitModal) btnSubmitModal.textContent = 'Crear Contacto';
    }

    updateModalTipoBadgePreview();
    modal.showModal();
    fContacto?.focus();
  }

  btnNuevoContacto?.addEventListener('click', () => openContactoModal());
  btnCloseModal?.addEventListener('click', () => modal?.close());
  btnCancelModal?.addEventListener('click', () => modal?.close());

  if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
    const outside = (e: PointerEvent, d: HTMLDialogElement) => {
      const r = d.getBoundingClientRect();
      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    };
    let pressedOutside = false;
    modal.addEventListener('pointerdown', (e) => {
      pressedOutside = outside(e, modal);
    });
    modal.addEventListener('pointerup', (e) => {
      if (pressedOutside && outside(e, modal)) modal.close();
    });
  }

  // Clic en fila para abrir modal (excepto enlaces de acción y botón de Eliminar Contacto)
  tbody?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-whatsapp-link], [data-pendiente-link], [data-pendiente-hoy-link]')) return;

    const deleteBtn = target.closest<HTMLButtonElement>('[data-delete-contacto]');
    if (deleteBtn) {
      event.stopPropagation();
      const id = Number(deleteBtn.dataset.deleteContacto);
      const name = deleteBtn.dataset.deleteName || `#${id}`;
      if (!id) return;

      if (!window.confirm(`¿Estás seguro de eliminar el contacto "${name}" de la base de datos D1?`)) {
        return;
      }

      deleteBtn.disabled = true;
      try {
        const response = await fetch(`/api/contactos?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
          const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
          row?.remove();
          recalculateStats();
          applyFilters();
          showSyncToast(`Contacto "${name}" eliminado de D1`);
        } else {
          alert('No se pudo eliminar el contacto.');
        }
      } catch {
        alert('Error de conexión al eliminar el contacto.');
      } finally {
        deleteBtn.disabled = false;
      }
      return;
    }

    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowRecord) return;
    const record = JSON.parse(row.dataset.rowRecord) as ContactoRecord;
    openContactoModal(record);
  });

  // Delegación global para el menú Hamburguesa, opciones de filtro y botón Limpiar
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const currentPanelFiltros = document.querySelector<HTMLElement>('#panel-filtros-contactos');
    const currentBtnHamburger = document.querySelector<HTMLButtonElement>('#btn-toggle-hamburger-contactos');

    // 1. Abrir / cerrar Hamburguesa
    const toggleBtn = target.closest<HTMLButtonElement>('#btn-toggle-hamburger-contactos');
    if (toggleBtn && currentPanelFiltros) {
      e.stopPropagation();
      const willOpen = currentPanelFiltros.classList.contains('hidden');
      if (willOpen) {
        currentPanelFiltros.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        currentPanelFiltros.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
      applyFilters();
      return;
    }

    // 2. Botón X para cerrar Hamburguesa
    const closeBtn = target.closest<HTMLButtonElement>('#btn-close-hamburger-contactos');
    if (closeBtn && currentPanelFiltros) {
      e.stopPropagation();
      currentPanelFiltros.classList.add('hidden');
      currentBtnHamburger?.setAttribute('aria-expanded', 'false');
      applyFilters();
      return;
    }

    // 3. Botón Limpiar filtros
    const resetBtn = target.closest<HTMLButtonElement>('#btn-reset-filtro-contactos');
    if (resetBtn) {
      e.stopPropagation();
      selectedFilter = 'ALL';
      const currentSearchInput = document.querySelector<HTMLInputElement>('#input-search-contactos');
      if (currentSearchInput) currentSearchInput.value = '';
      if (currentPanelFiltros) {
        currentPanelFiltros.classList.add('hidden');
        currentBtnHamburger?.setAttribute('aria-expanded', 'false');
      }
      applyFilters();
      const tableWrapper = document.querySelector<HTMLElement>('.table-wrapper');
      if (tableWrapper) tableWrapper.scrollTop = 0;
      return;
    }

    // 4. Selección de cualquier filtro (en la Hamburguesa o en las píldoras superiores)
    const pill = target.closest<HTMLButtonElement>('[data-filter-pill]');
    if (pill) {
      e.stopPropagation();
      const targetFilter = pill.dataset.filterPill || 'ALL';
      const isInsideMenu = Boolean(currentPanelFiltros && currentPanelFiltros.contains(pill));

      if (isInsideMenu) {
        // Al seleccionar desde la lista de filtros, siempre activar directamente ese filtro
        selectedFilter = targetFilter;
        currentPanelFiltros?.classList.add('hidden');
        currentBtnHamburger?.setAttribute('aria-expanded', 'false');
      } else {
        // En las píldoras superiores, permitir activar ese filtro (o volver a ALL si ya estaba activo)
        selectedFilter = selectedFilter === targetFilter && targetFilter !== 'ALL' ? 'ALL' : targetFilter;
      }

      applyFilters();
      const tableWrapper = document.querySelector<HTMLElement>('.table-wrapper');
      if (tableWrapper) tableWrapper.scrollTop = 0;
      return;
    }

    // 5. Clic fuera del menú Hamburguesa -> cerrarlo
    if (
      currentPanelFiltros &&
      !currentPanelFiltros.classList.contains('hidden') &&
      !currentPanelFiltros.contains(target) &&
      !currentBtnHamburger?.contains(target)
    ) {
      currentPanelFiltros.classList.add('hidden');
      currentBtnHamburger?.setAttribute('aria-expanded', 'false');
      applyFilters();
    }
  });

  document.addEventListener('input', (e) => {
    const target = e.target as HTMLElement | null;
    if (target && target.id === 'input-search-contactos') {
      applyFilters();
    }
  });

  // Eliminar Contacto
  btnDeleteModal?.addEventListener('click', async () => {
    const idVal = fId?.value?.trim();
    if (!idVal) return;
    const id = Number(idVal);

    if (!window.confirm(`¿Estás seguro de eliminar el contacto #${id} de la base de datos D1?`)) {
      return;
    }

    btnDeleteModal.disabled = true;
    try {
      const response = await fetch(`/api/contactos?id=${id}`, { method: 'DELETE' });
      if (response.ok) {
        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
        row?.remove();
        recalculateStats();
        applyFilters();
        modal?.close();
        showSyncToast(`Contacto #${id} eliminado de D1`);
      }
    } finally {
      btnDeleteModal.disabled = false;
    }
  });

  // Guardar Cambios o Crear Contacto
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btnSubmitModal) return;

    const idVal = fId?.value?.trim();
    const contacto = fContacto?.value?.trim();
    if (!contacto) {
      alert('El nombre o identificador del cliente/contacto es obligatorio.');
      fContacto?.focus();
      return;
    }

    const payload = {
      ...(idVal ? { id: Number(idVal) } : {}),
      contacto,
      telefono: fTelefono?.value?.trim() || '-',
      email: fEmail?.value?.trim() || '-',
      nombres: fNombres?.value?.trim() || '-',
      apellidos: fApellidos?.value?.trim() || '-',
      fecha_nacimiento: fNacimiento?.value?.trim() || '-',
      genero: fGenero?.value || '-',
      tipo_cliente: fTipoCliente?.value || '-',
      numero_pasaporte: fPasaporte?.value?.trim() || '-',
      nacionalidad_pasaporte: fNacionalidad?.value?.trim() || '-',
      fecha_emision_pasaporte: fEmision?.value?.trim() || '-',
      fecha_vencimiento_pasaporte: fVencimiento?.value?.trim() || '-',
    };

    btnSubmitModal.disabled = true;
    btnSubmitModal.textContent = 'Guardando...';

    try {
      const method = idVal ? 'PATCH' : 'POST';
      const response = await fetch('/api/contactos', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as { ok?: boolean; data?: ContactoRecord; error?: string };

      if (response.ok && result.ok && result.data) {
        const updated = result.data;

        if (!idVal) {
          modal?.close();
          window.location.reload();
          return;
        }

        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${updated.id}"]`);
        if (row) {
          const updatedTipoCliente = (updated.tipo_cliente || payload.tipo_cliente || '-').trim() || '-';
          updated.tipo_cliente = updatedTipoCliente;
          row.dataset.rowRecord = JSON.stringify(updated);
          row.dataset.rowContacto = updated.contacto;
          row.dataset.rowTel = updated.telefono;
          row.dataset.rowHasTel = updated.telefono && updated.telefono !== '-' ? '1' : '0';
          row.dataset.rowSinNombre = isContactoSinNombre(updated) ? '1' : '0';
          row.dataset.rowHasPas = updated.numero_pasaporte && updated.numero_pasaporte !== '-' ? '1' : '0';
          row.dataset.rowHasEmail = updated.email && updated.email !== '-' ? '1' : '0';
          row.dataset.rowTipoCliente = updatedTipoCliente;

          const cellContacto = row.querySelector<HTMLElement>(`[data-cell-contacto="${updated.id}"]`);
          const telSpan = row.querySelector<HTMLElement>(`[data-tel-text-for="${updated.id}"]`);
          const cellEmail = row.querySelector<HTMLElement>(`[data-cell-email="${updated.id}"]`);
          const cellFullname = row.querySelector<HTMLElement>(`[data-cell-fullname="${updated.id}"]`);
          const cellGenero = row.querySelector<HTMLElement>(`[data-cell-genero="${updated.id}"]`);
          const cellPasaporte = row.querySelector<HTMLElement>(`[data-cell-pasaporte="${updated.id}"]`);
          const cellVencimiento = row.querySelector<HTMLElement>(`[data-cell-vencimiento="${updated.id}"]`);

          const nameSpan = row.querySelector<HTMLElement>(`[data-name-for="${updated.id}"]`);
          const tipoBadge = row.querySelector<HTMLElement>(`[data-tipo-badge-for="${updated.id}"]`);
          const tipoPlaceholder = row.querySelector<HTMLElement>(`[data-tipo-placeholder-for="${updated.id}"]`);
          const pendienteAnchor = row.querySelector<HTMLAnchorElement>(`[data-pendiente-for="${updated.id}"]`);
          const hoyAnchor = row.querySelector<HTMLAnchorElement>(`[data-hoy-for="${updated.id}"]`);
          const waAnchor = row.querySelector<HTMLAnchorElement>(`[data-wa-for="${updated.id}"]`);
          const delBtn = row.querySelector<HTMLButtonElement>(`[data-delete-contacto="${updated.id}"]`);
          if (nameSpan) {
            nameSpan.textContent = updated.contacto;
          } else if (cellContacto) {
            cellContacto.textContent = updated.contacto;
          }
          if (tipoBadge) {
            if (updatedTipoCliente && updatedTipoCliente !== '-') {
              tipoBadge.textContent = updatedTipoCliente;
              tipoBadge.className = `inline-flex items-center justify-center rounded-md px-2.5 py-0.5 text-[11px] font-extrabold tracking-wide leading-tight ${getTipoClienteBadgeClass(updatedTipoCliente)}`;
              if (tipoPlaceholder) tipoPlaceholder.className = 'hidden';
            } else {
              tipoBadge.textContent = '';
              tipoBadge.className = 'hidden';
              if (tipoPlaceholder) tipoPlaceholder.className = 'text-xs text-primary/40 font-normal';
            }
          }
          if (pendienteAnchor) {
            pendienteAnchor.href = `/?contacto=${encodeURIComponent(updated.contacto)}`;
          }
          if (hoyAnchor) {
            hoyAnchor.href = `/pendientes-hoy?contacto=${encodeURIComponent(updated.contacto)}`;
          }
          if (waAnchor) {
            const newWa = buildWhatsAppDynamicLink(updated.contacto, updated.telefono);
            waAnchor.href = newWa.url;
            waAnchor.title = newWa.label;
            waAnchor.setAttribute('aria-label', newWa.label);
          }
          if (delBtn) {
            delBtn.dataset.deleteName = updated.contacto;
            delBtn.title = `Eliminar contacto de ${updated.contacto}`;
            delBtn.setAttribute('aria-label', `Eliminar contacto de ${updated.contacto}`);
          }
          if (telSpan) {
            telSpan.innerHTML =
              updated.telefono !== '-'
                ? `<span class="text-primary font-mono">${updated.telefono}</span>`
                : `<span class="text-primary/40 font-normal">-</span>`;
          }
          if (cellEmail) {
            cellEmail.innerHTML =
              updated.email !== '-'
                ? `<span class="text-blue-600 font-medium">${updated.email}</span>`
                : `<span class="text-primary/40 font-normal">-</span>`;
          }
          if (cellFullname) {
            const fn =
              updated.nombres !== '-' || updated.apellidos !== '-'
                ? `${updated.nombres !== '-' ? updated.nombres : ''} ${updated.apellidos !== '-' ? updated.apellidos : ''}`.trim()
                : '-';
            cellFullname.textContent = fn;
          }
          if (cellGenero) cellGenero.textContent = updated.genero;
          if (cellPasaporte) {
            cellPasaporte.innerHTML =
              updated.numero_pasaporte !== '-'
                ? `<div class="flex items-center gap-1.5"><span class="text-secondary">${updated.numero_pasaporte}</span>${
                    updated.nacionalidad_pasaporte !== '-'
                      ? `<span class="text-[10px] uppercase font-sans font-bold bg-primary/10 text-primary px-1.5 py-0.5 rounded">${updated.nacionalidad_pasaporte}</span>`
                      : ''
                  }</div>`
                : `<span class="text-primary/40 font-normal font-sans">-</span>`;
          }
          if (cellVencimiento) cellVencimiento.textContent = updated.fecha_vencimiento_pasaporte;
        }

        recalculateStats();
        applyFilters();
        modal?.close();
        showSyncToast(`Contacto #${updated.id} guardado en D1`);
      } else {
        alert(result.error || 'Error al guardar el contacto.');
      }
    } catch {
      alert('Error de conexión al guardar el contacto.');
    } finally {
      btnSubmitModal.disabled = false;
      btnSubmitModal.textContent = 'Guardar Cambios';
    }
  });

  // Sincronizar en el navegador los iconos de "Pendientes de Hoy" usando la fecha local exacta
  function syncPendientesHoyIconsClient() {
    if (!tbody) return;
    const now = new Date();
    const refDate = createMidnightDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));

    for (const row of rows) {
      const id = row.dataset.rowId;
      const rawPendientes = row.dataset.rowPendientes;
      const hoyAnchor = row.querySelector<HTMLAnchorElement>(`[data-hoy-for="${id}"]`);
      if (!hoyAnchor) continue;
      if (!rawPendientes) {
        hoyAnchor.classList.add('hidden');
        hoyAnchor.classList.remove('inline-flex');
        continue;
      }
      try {
        const list = JSON.parse(rawPendientes) as PendienteRecord[];
        const matches = list
          .map((p) => evaluatePendienteForHoy(p, refDate))
          .filter((ev) => ev.matches);
        if (matches.length > 0) {
          const labels = matches.map((m) => m.matchLabel).join(' | ');
          hoyAnchor.title = `Pendiente para HOY (${labels}) — Ir a Pendientes Hoy`;
          hoyAnchor.classList.remove('hidden');
          hoyAnchor.classList.add('inline-flex');
        } else {
          hoyAnchor.classList.add('hidden');
          hoyAnchor.classList.remove('inline-flex');
        }
      } catch {}
    }
  }

  syncPendientesHoyIconsClient();
</script>
