              );
            })
          }
          <tr id="contactos-empty-filter-row" class="hidden" hidden>
            <td colspan="3" class="py-10 px-4 text-center text-sm font-semibold text-primary/70">
              No se encontraron contactos para el filtro seleccionado.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Modal para Ver / Editar / Crear Ficha de Contacto -->
<dialog
  id="modal-contacto"
