---
import { CONTACTOS_GRID_COLUMNS } from '@/constants/site';
import type { ContactoRecord } from '@/types';
import { buildWhatsAppDynamicLink } from '@/utils/pagoHelpers';

interface Props {
  contactos: ContactoRecord[];
}

const { contactos } = Astro.props;

const totalContactos = contactos.length;
const conTelefono = contactos.filter((c) => c.telefono && c.telefono.trim() !== '-' && c.telefono.trim() !== '').length;
const sinTelefono = totalContactos - conTelefono;
const conPasaporte = contactos.filter((c) => c.numero_pasaporte && c.numero_pasaporte !== '-').length;
const conEmail = contactos.filter((c) => c.email && c.email !== '-').length;
---

<section class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
  <!-- Píldoras de Análisis y Filtros Rápidos -->
  <div class="bg-base rounded-xl border border-base-border p-4 shadow-xs">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3">
      <!-- Todos -->
      <button
        type="button"
        data-filter-pill="ALL"
        class="contactos-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3.5 py-2.5 text-left transition hover:shadow-sm cursor-pointer bg-blue-50 border-blue-200 text-blue-900 ring-2 ring-primary scale-[1.02]"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-blue-600"></span>
          <span class="text-xs font-bold truncate">Todos los Contactos</span>
        </div>
        <span
          id="stat-total"
          class="inline-flex items-center justify-center rounded-md bg-base/80 text-primary px-2.5 py-0.5 text-xs font-extrabold shrink-0"
        >
          {totalContactos}
        </span>
      </button>

      <!-- Con Teléfono -->
      <button
        type="button"
        data-filter-pill="CON_TEL"
        class="contactos-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3.5 py-2.5 text-left transition hover:shadow-sm cursor-pointer bg-emerald-50 border-emerald-200 text-emerald-900"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-600"></span>
          <span class="text-xs font-bold truncate">Con Teléfono</span>
        </div>
        <span
          id="stat-tel"
          class="inline-flex items-center justify-center rounded-md bg-base/80 text-primary px-2.5 py-0.5 text-xs font-extrabold shrink-0"
        >
          {conTelefono}
        </span>
      </button>

      <!-- Sin Teléfono -->
      <button
        type="button"
        data-filter-pill="SIN_TEL"
        class="contactos-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3.5 py-2.5 text-left transition hover:shadow-sm cursor-pointer bg-rose-50 border-rose-200 text-rose-900"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-secondary"></span>
          <span class="text-xs font-bold truncate">Sin Teléfono</span>
        </div>
        <span
          id="stat-sin-tel"
          class="inline-flex items-center justify-center rounded-md bg-base/80 text-secondary px-2.5 py-0.5 text-xs font-extrabold shrink-0"
        >
          {sinTelefono}
        </span>
      </button>

      <!-- Con Pasaporte -->
      <button
        type="button"
        data-filter-pill="CON_PAS"
        class="contactos-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3.5 py-2.5 text-left transition hover:shadow-sm cursor-pointer bg-purple-50 border-purple-200 text-purple-900"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-purple-600"></span>
          <span class="text-xs font-bold truncate">Con Pasaporte</span>
        </div>
        <span
          id="stat-pas"
          class="inline-flex items-center justify-center rounded-md bg-base/80 text-primary px-2.5 py-0.5 text-xs font-extrabold shrink-0"
        >
          {conPasaporte}
        </span>
      </button>

      <!-- Con Email -->
      <button
        type="button"
        data-filter-pill="CON_EMAIL"
        class="contactos-filter-pill flex items-center justify-between gap-2 rounded-lg border px-3.5 py-2.5 text-left transition hover:shadow-sm cursor-pointer bg-amber-50 border-amber-200 text-amber-900"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-amber-600"></span>
          <span class="text-xs font-bold truncate">Con Email</span>
        </div>
        <span
          id="stat-email"
          class="inline-flex items-center justify-center rounded-md bg-base/80 text-primary px-2.5 py-0.5 text-xs font-extrabold shrink-0"
        >
          {conEmail}
        </span>
      </button>
    </div>
  </div>

  <!-- Barra de búsqueda + Formulario de Filtro de Contactos (al lado del buscador) + Nuevo Contacto -->
  <div class="bg-base rounded-xl border border-base-border p-4 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    <form
      id="form-filtro-contactos"
      class="flex flex-1 flex-col sm:flex-row items-stretch sm:items-center gap-2.5"
      onsubmit="return false;"
    >
      <!-- Buscador de texto -->
      <div class="relative flex-1 max-w-md">
        <input
          type="search"
          id="input-search-contactos"
          placeholder="Buscar por cliente, teléfono, nombres, pasaporte..."
          class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 text-sm text-primary placeholder:text-primary/50 focus:border-primary focus:bg-base focus:outline-none"
        />
      </div>

      <!-- Selector de Filtro al lado del buscador -->
      <div class="flex items-center gap-2">
        <label for="select-filtro-contactos" class="text-xs font-extrabold uppercase text-primary/70 whitespace-nowrap">
          Filtrar:
        </label>
        <select
          id="select-filtro-contactos"
          name="filtro_contacto"
          aria-label="Filtrar contactos por teléfono, pasaporte o email"
          class="rounded-lg border border-base-border bg-base-muted px-3 py-2 text-xs sm:text-sm font-bold text-primary focus:border-primary focus:bg-base focus:outline-none cursor-pointer"
        >
          <option value="ALL">Todos los contactos ({totalContactos})</option>
          <option value="SIN_TEL">📵 Contactos Sin Teléfono ({sinTelefono})</option>
          <option value="CON_TEL">📞 Contactos Con Teléfono ({conTelefono})</option>
          <option value="CON_PAS">🛂 Con Pasaporte ({conPasaporte})</option>
          <option value="SIN_PAS">⚠️ Sin Pasaporte ({totalContactos - conPasaporte})</option>
          <option value="CON_EMAIL">✉️ Con Email ({conEmail})</option>
        </select>

        <!-- Botón directo rápido para ver Contactos Sin Teléfono -->
        <button
          type="button"
          id="btn-toggle-sin-telefono"
          title="Alternar vista de contactos que no tienen número de teléfono registrado"
          class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/50 bg-rose-50 hover:bg-secondary hover:text-white text-secondary font-extrabold px-3 py-2 text-xs transition cursor-pointer whitespace-nowrap"
        >
          <span>📵</span>
          <span>Sin Teléfono (<span id="btn-stat-sin-tel">{sinTelefono}</span>)</span>
        </button>

        <button
          type="button"
          id="btn-reset-filtro-contactos"
          title="Restablecer búsqueda y filtros"
          class="hidden rounded-lg border border-base-border bg-base-muted hover:bg-base px-2.5 py-2 text-xs font-bold text-primary/70 hover:text-primary transition cursor-pointer whitespace-nowrap"
        >
          Limpiar ✕
        </button>
      </div>
    </form>

    <div class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-primary">
      <span id="visible-rows-counter">
        Mostrando <strong>{contactos.length}</strong> de <strong>{contactos.length}</strong>
      </span>
      <span
        id="d1-sync-toast"
        class="hidden rounded-md bg-emerald-50 text-emerald-800 border border-emerald-300 px-2.5 py-1 text-xs font-bold transition"
      >
        Guardado en D1
      </span>
      <button
        type="button"
        id="btn-nuevo-contacto"
        class="rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-base font-bold px-4 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer ml-auto sm:ml-0"
      >
        <span>+</span>
        <span>Nuevo Contacto</span>
      </button>
    </div>
  </div>

  <!-- Tabla de Contactos -->
  <div class="bg-base rounded-xl border border-base-border shadow-xs overflow-hidden">
    <div
      tabindex="0"
      role="region"
      aria-labelledby="contactos-table-caption"
      class="table-wrapper"
    >
      <table class="clientes-table text-left text-sm">
        <caption id="contactos-table-caption" class="sr-only">
          Directorio general de clientes y pasaportes de Global Travel CW
        </caption>
        <thead class="bg-primary text-base text-xs uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[200px]">
              {CONTACTOS_GRID_COLUMNS.contacto}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[140px]">
              {CONTACTOS_GRID_COLUMNS.telefono}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[160px]">
              {CONTACTOS_GRID_COLUMNS.email}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[180px]">
              {CONTACTOS_GRID_COLUMNS.nombre_completo}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[90px]">
              {CONTACTOS_GRID_COLUMNS.genero}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[150px]">
              {CONTACTOS_GRID_COLUMNS.pasaporte}
            </th>
            <th scope="col" class="py-3.5 px-4 font-bold border-b-2 border-secondary min-w-[120px]">
              {CONTACTOS_GRID_COLUMNS.vencimiento}
            </th>
          </tr>
        </thead>
        <tbody id="contactos-tbody" class="divide-y divide-base-border">
          {
            contactos.map((c) => {
              const fullName =
                c.nombres !== '-' || c.apellidos !== '-'
                  ? `${c.nombres !== '-' ? c.nombres : ''} ${c.apellidos !== '-' ? c.apellidos : ''}`.trim()
                  : '-';
              const waInfo = buildWhatsAppDynamicLink(c.contacto, c.telefono);
              return (
                <tr
                  tabindex="0"
                  role="button"
                  aria-label={`Abrir ficha de contacto de ${c.contacto}`}
                  data-row-id={c.id}
                  data-row-contacto={c.contacto}
                  data-row-tel={c.telefono}
                  data-row-has-tel={c.telefono && c.telefono !== '-' ? '1' : '0'}
                  data-row-has-pas={c.numero_pasaporte && c.numero_pasaporte !== '-' ? '1' : '0'}
                  data-row-has-email={c.email && c.email !== '-' ? '1' : '0'}
                  data-row-record={JSON.stringify(c)}
                  class="hover:bg-base-muted focus:bg-base-muted focus:outline-none transition-colors cursor-pointer"
                >
                  <th
                    scope="row"
                    data-cell-contacto={c.id}
                    class="py-3.5 px-4 font-bold text-primary border-r border-base-border align-middle"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <span data-name-for={c.id} class="text-sm leading-snug">{c.contacto}</span>
                      <a
                        href={waInfo.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-whatsapp-link="true"
                        data-wa-for={c.id}
                        title={waInfo.label}
                        aria-label={waInfo.label}
                        class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white shadow-xs transition transform hover:scale-105"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.531 5.86L0 24l6.335-1.652c1.688.919 3.621 1.444 5.666 1.444 6.627 0 12-5.373 12-12s-5.373-12-11.993-12z"/></svg>
                      </a>
                    </div>
                  </th>

                  <td
                    data-cell-telefono={c.id}
                    class="py-3.5 px-4 align-middle text-xs font-semibold text-primary/90 whitespace-nowrap"
                  >
                    {c.telefono !== '-' ? (
                      <span class="text-primary font-mono">{c.telefono}</span>
                    ) : (
                      <span class="text-primary/40 font-normal">-</span>
                    )}
                  </td>

                  <td
                    data-cell-email={c.id}
                    class="py-3.5 px-4 align-middle text-xs text-primary/80"
                  >
                    {c.email !== '-' ? (
                      <span class="text-blue-600 font-medium">{c.email}</span>
                    ) : (
                      <span class="text-primary/40 font-normal">-</span>
                    )}
                  </td>

                  <td
                    data-cell-fullname={c.id}
                    class="py-3.5 px-4 align-middle text-xs font-medium text-primary"
                  >
                    {fullName}
                  </td>

                  <td
                    data-cell-genero={c.id}
                    class="py-3.5 px-4 align-middle text-xs text-primary/80 whitespace-nowrap"
                  >
                    {c.genero}
                  </td>

                  <td
                    data-cell-pasaporte={c.id}
                    class="py-3.5 px-4 align-middle text-xs font-mono font-bold"
                  >
                    {c.numero_pasaporte !== '-' ? (
                      <div class="flex items-center gap-1.5">
                        <span class="text-secondary">{c.numero_pasaporte}</span>
                        {c.nacionalidad_pasaporte !== '-' && (
                          <span class="text-[10px] uppercase font-sans font-bold bg-primary/10 text-primary px-1.5 py-0.5 rounded">
                            {c.nacionalidad_pasaporte}
                          </span>
                        )}
                      </div>
                    ) : (
                      <span class="text-primary/40 font-normal font-sans">-</span>
                    )}
                  </td>

                  <td
                    data-cell-vencimiento={c.id}
                    class="py-3.5 px-4 align-middle text-xs font-medium text-primary whitespace-nowrap"
                  >
                    {c.fecha_vencimiento_pasaporte}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Modal para Ver / Editar / Crear Ficha de Contacto -->
<dialog
  id="modal-contacto"
  class="m-auto rounded-2xl bg-base p-0 shadow-2xl backdrop:bg-primary-dark/60 backdrop:backdrop-blur-xs max-w-2xl w-[94vw] border border-base-border overflow-hidden"
  aria-labelledby="modal-contacto-title"
>
  <form id="form-contacto" method="dialog" class="flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between bg-primary px-6 py-4 text-base">
      <div>
        <h3 id="modal-contacto-title" class="text-lg font-extrabold tracking-tight">
          Ficha de Contacto
        </h3>
        <p id="modal-contacto-subtitle" class="text-xs text-base-muted/80 mt-0.5">
          Datos generales de cliente y pasaporte
        </p>
      </div>
      <button
        type="button"
        id="btn-close-modal-contacto"
        class="rounded-lg bg-base/10 hover:bg-base/20 px-3 py-1.5 text-xs font-bold transition cursor-pointer"
      >
        Cerrar ✕
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-4 text-sm max-h-[75vh] overflow-y-auto">
      <input type="hidden" id="field-contacto-id" name="id" value="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Contacto (Identificador Principal) -->
        <div class="sm:col-span-2">
          <label for="field-contacto-contacto" class="block text-xs font-bold uppercase text-primary mb-1">
            Cliente / Contacto (Nombre para Pendientes y Pagos) *
          </label>
          <input
            type="text"
            id="field-contacto-contacto"
            name="contacto"
            required
            placeholder="Ej. Jaime Goenaga Pax | +599 9 600 0000"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 text-primary font-semibold focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Teléfono -->
        <div>
          <label for="field-contacto-telefono" class="block text-xs font-bold uppercase text-primary mb-1">
            Teléfono
          </label>
          <input
            type="text"
            id="field-contacto-telefono"
            name="telefono"
            placeholder="+599 9 520 1234"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary font-mono focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="field-contacto-email" class="block text-xs font-bold uppercase text-primary mb-1">
            Email
          </label>
          <input
            type="email"
            id="field-contacto-email"
            name="email"
            placeholder="cliente@ejemplo.com"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Nombres -->
        <div>
          <label for="field-contacto-nombres" class="block text-xs font-bold uppercase text-primary mb-1">
            Nombres
          </label>
          <input
            type="text"
            id="field-contacto-nombres"
            name="nombres"
            placeholder="Ej. Jaime Alberto"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Apellidos -->
        <div>
          <label for="field-contacto-apellidos" class="block text-xs font-bold uppercase text-primary mb-1">
            Apellidos
          </label>
          <input
            type="text"
            id="field-contacto-apellidos"
            name="apellidos"
            placeholder="Ej. Goenaga Pax"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Fecha Nacimiento -->
        <div>
          <label for="field-contacto-nacimiento" class="block text-xs font-bold uppercase text-primary mb-1">
            Fecha de Nacimiento
          </label>
          <input
            type="text"
            id="field-contacto-nacimiento"
            name="fecha_nacimiento"
            placeholder="DD/MM/AAAA"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Género -->
        <div>
          <label for="field-contacto-genero" class="block text-xs font-bold uppercase text-primary mb-1">
            Género
          </label>
          <select
            id="field-contacto-genero"
            name="genero"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 font-semibold text-primary focus:border-primary focus:bg-base focus:outline-none cursor-pointer"
          >
            <option value="-">-</option>
            <option value="Masculino">Masculino</option>
            <option value="Femenino">Femenino</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <!-- Pasaporte: Número -->
        <div>
          <label for="field-contacto-pasaporte" class="block text-xs font-bold uppercase text-primary mb-1">
            Número de Pasaporte
          </label>
          <input
            type="text"
            id="field-contacto-pasaporte"
            name="numero_pasaporte"
            placeholder="Ej. PA12345678"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 font-mono font-bold text-secondary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Pasaporte: Nacionalidad -->
        <div>
          <label for="field-contacto-nacionalidad" class="block text-xs font-bold uppercase text-primary mb-1">
            Nacionalidad del Pasaporte
          </label>
          <input
            type="text"
            id="field-contacto-nacionalidad"
            name="nacionalidad_pasaporte"
            placeholder="Ej. Venezolana, Holandesa, Colombiana..."
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Pasaporte: Fecha Emisión -->
        <div>
          <label for="field-contacto-emision" class="block text-xs font-bold uppercase text-primary mb-1">
            Fecha Emisión Pasaporte
          </label>
          <input
            type="text"
            id="field-contacto-emision"
            name="fecha_emision_pasaporte"
            placeholder="DD/MM/AAAA"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Pasaporte: Fecha Vencimiento -->
        <div>
          <label for="field-contacto-vencimiento" class="block text-xs font-bold uppercase text-primary mb-1">
            Fecha Vencimiento Pasaporte
          </label>
          <input
            type="text"
            id="field-contacto-vencimiento"
            name="fecha_vencimiento_pasaporte"
            placeholder="DD/MM/AAAA"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-base-muted px-6 py-4 border-t border-base-border">
      <div>
        <button
          type="button"
          id="btn-delete-modal-contacto"
          class="inline-flex items-center gap-1.5 rounded-lg bg-secondary/10 border border-secondary px-4 py-2 text-xs font-extrabold text-secondary hover:bg-secondary hover:text-base transition cursor-pointer"
        >
          Eliminar Contacto
        </button>
      </div>

      <div class="flex items-center gap-2.5 ml-auto">
        <button
          type="button"
          id="btn-cancel-modal-contacto"
          class="rounded-lg border border-base-border bg-base px-4 py-2 text-xs font-semibold text-primary hover:bg-base-muted transition cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-modal-contacto"
          class="rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-base font-bold px-5 py-2 text-xs shadow-xs transition cursor-pointer"
        >
          Guardar Cambios
        </button>
      </div>
    </div>
  </form>
</dialog>

<script>
  import type { ContactoRecord } from '@/types';
  import { buildWhatsAppDynamicLink } from '@/utils/pagoHelpers';

  const searchInput = document.querySelector<HTMLInputElement>('#input-search-contactos');
  const selectFiltro = document.querySelector<HTMLSelectElement>('#select-filtro-contactos');
  const btnToggleSinTel = document.querySelector<HTMLButtonElement>('#btn-toggle-sin-telefono');
  const btnResetFiltro = document.querySelector<HTMLButtonElement>('#btn-reset-filtro-contactos');
  let selectedFilter = 'ALL';
  const tbody = document.querySelector<HTMLTableSectionElement>('#contactos-tbody');
  const visibleCounter = document.querySelector<HTMLElement>('#visible-rows-counter');
  const syncToast = document.querySelector<HTMLElement>('#d1-sync-toast');
  const btnNuevoContacto = document.querySelector<HTMLButtonElement>('#btn-nuevo-contacto');

  // Modal Contacto
  const modal = document.querySelector<HTMLDialogElement>('#modal-contacto');
  const form = document.querySelector<HTMLFormElement>('#form-contacto');
  const modalTitle = document.querySelector<HTMLElement>('#modal-contacto-title');
  const modalSubtitle = document.querySelector<HTMLElement>('#modal-contacto-subtitle');
  const btnCloseModal = document.querySelector<HTMLButtonElement>('#btn-close-modal-contacto');
  const btnCancelModal = document.querySelector<HTMLButtonElement>('#btn-cancel-modal-contacto');
  const btnDeleteModal = document.querySelector<HTMLButtonElement>('#btn-delete-modal-contacto');
  const btnSubmitModal = document.querySelector<HTMLButtonElement>('#btn-submit-modal-contacto');

  const fId = document.querySelector<HTMLInputElement>('#field-contacto-id');
  const fContacto = document.querySelector<HTMLInputElement>('#field-contacto-contacto');
  const fTelefono = document.querySelector<HTMLInputElement>('#field-contacto-telefono');
  const fEmail = document.querySelector<HTMLInputElement>('#field-contacto-email');
  const fNombres = document.querySelector<HTMLInputElement>('#field-contacto-nombres');
  const fApellidos = document.querySelector<HTMLInputElement>('#field-contacto-apellidos');
  const fNacimiento = document.querySelector<HTMLInputElement>('#field-contacto-nacimiento');
  const fGenero = document.querySelector<HTMLSelectElement>('#field-contacto-genero');
  const fPasaporte = document.querySelector<HTMLInputElement>('#field-contacto-pasaporte');
  const fNacionalidad = document.querySelector<HTMLInputElement>('#field-contacto-nacionalidad');
  const fEmision = document.querySelector<HTMLInputElement>('#field-contacto-emision');
  const fVencimiento = document.querySelector<HTMLInputElement>('#field-contacto-vencimiento');

  function showSyncToast(text = 'Guardado en D1') {
    if (!syncToast) return;
    syncToast.textContent = text;
    syncToast.classList.remove('hidden');
    window.setTimeout(() => {
      syncToast.classList.add('hidden');
    }, 2600);
  }

  function applyFilters() {
    if (!tbody) return;
    const query = (searchInput?.value ?? '').toLowerCase().trim();
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));

    let visibleCount = 0;
    for (const row of rows) {
      const recordStr = row.dataset.rowRecord || '';
      const rec = JSON.parse(recordStr) as ContactoRecord;

      const fullSearch = `${rec.contacto} ${rec.telefono} ${rec.email} ${rec.nombres} ${rec.apellidos} ${rec.numero_pasaporte} ${rec.nacionalidad_pasaporte}`.toLowerCase();
      const matchesQuery = !query || fullSearch.includes(query);

      const hasTel = Boolean(rec.telefono && rec.telefono.trim() !== '-' && rec.telefono.trim() !== '');
      const hasPas = Boolean(rec.numero_pasaporte && rec.numero_pasaporte.trim() !== '-' && rec.numero_pasaporte.trim() !== '');
      const hasEmail = Boolean(rec.email && rec.email.trim() !== '-' && rec.email.trim() !== '');

      let matchesFilter = true;
      if (selectedFilter === 'CON_TEL') {
        matchesFilter = hasTel;
      } else if (selectedFilter === 'SIN_TEL') {
        matchesFilter = !hasTel;
      } else if (selectedFilter === 'CON_PAS') {
        matchesFilter = hasPas;
      } else if (selectedFilter === 'SIN_PAS') {
        matchesFilter = !hasPas;
      } else if (selectedFilter === 'CON_EMAIL') {
        matchesFilter = hasEmail;
      }

      if (matchesQuery && matchesFilter) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    }

    if (visibleCounter) {
      visibleCounter.innerHTML = `Mostrando <strong>${visibleCount}</strong> de <strong>${rows.length}</strong>`;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-filter-pill]').forEach((pill) => {
      if (pill.dataset.filterPill === selectedFilter) {
        pill.classList.add('ring-2', 'ring-primary', 'scale-[1.02]');
      } else {
        pill.classList.remove('ring-2', 'ring-primary', 'scale-[1.02]');
      }
    });

    if (selectFiltro && selectFiltro.value !== selectedFilter) {
      selectFiltro.value = selectedFilter;
    }

    if (btnToggleSinTel) {
      if (selectedFilter === 'SIN_TEL') {
        btnToggleSinTel.classList.remove('bg-rose-50', 'text-secondary');
        btnToggleSinTel.classList.add('bg-secondary', 'text-white', 'ring-2', 'ring-secondary/40');
      } else {
        btnToggleSinTel.classList.add('bg-rose-50', 'text-secondary');
        btnToggleSinTel.classList.remove('bg-secondary', 'text-white', 'ring-2', 'ring-secondary/40');
      }
    }

    if (btnResetFiltro) {
      if (selectedFilter !== 'ALL' || Boolean(query)) {
        btnResetFiltro.classList.remove('hidden');
      } else {
        btnResetFiltro.classList.add('hidden');
      }
    }
  }

  function recalculateStats() {
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-row-id]'));
    let telCount = 0;
    let pasCount = 0;
    let emailCount = 0;

    for (const row of rows) {
      if (row.dataset.rowHasTel === '1') telCount++;
      if (row.dataset.rowHasPas === '1') pasCount++;
      if (row.dataset.rowHasEmail === '1') emailCount++;
    }

    const sinTelCount = rows.length - telCount;
    const statTotal = document.querySelector('#stat-total');
    const statTel = document.querySelector('#stat-tel');
    const statSinTel = document.querySelector('#stat-sin-tel');
    const btnStatSinTel = document.querySelector('#btn-stat-sin-tel');
    const statPas = document.querySelector('#stat-pas');
    const statEmail = document.querySelector('#stat-email');

    if (statTotal) statTotal.textContent = String(rows.length);
    if (statTel) statTel.textContent = String(telCount);
    if (statSinTel) statSinTel.textContent = String(sinTelCount);
    if (btnStatSinTel) btnStatSinTel.textContent = String(sinTelCount);
    if (statPas) statPas.textContent = String(pasCount);
    if (statEmail) statEmail.textContent = String(emailCount);
  }

  function openContactoModal(record?: ContactoRecord) {
    if (!modal || !form) return;

    if (record) {
      if (modalTitle) modalTitle.textContent = `Ficha de Contacto #${record.id}`;
      if (modalSubtitle) modalSubtitle.textContent = `Actualización de datos en Cloudflare D1`;
      if (fId) fId.value = String(record.id);
      if (fContacto) fContacto.value = record.contacto;
      if (fTelefono) fTelefono.value = record.telefono === '-' ? '' : record.telefono;
      if (fEmail) fEmail.value = record.email === '-' ? '' : record.email;
      if (fNombres) fNombres.value = record.nombres === '-' ? '' : record.nombres;
      if (fApellidos) fApellidos.value = record.apellidos === '-' ? '' : record.apellidos;
      if (fNacimiento) fNacimiento.value = record.fecha_nacimiento === '-' ? '' : record.fecha_nacimiento;
      if (fGenero) fGenero.value = record.genero || '-';
      if (fPasaporte) fPasaporte.value = record.numero_pasaporte === '-' ? '' : record.numero_pasaporte;
      if (fNacionalidad) fNacionalidad.value = record.nacionalidad_pasaporte === '-' ? '' : record.nacionalidad_pasaporte;
      if (fEmision) fEmision.value = record.fecha_emision_pasaporte === '-' ? '' : record.fecha_emision_pasaporte;
      if (fVencimiento) fVencimiento.value = record.fecha_vencimiento_pasaporte === '-' ? '' : record.fecha_vencimiento_pasaporte;

      if (btnDeleteModal) btnDeleteModal.classList.remove('hidden');
      if (btnSubmitModal) btnSubmitModal.textContent = 'Guardar Cambios';
    } else {
      form.reset();
      if (modalTitle) modalTitle.textContent = 'Nuevo Contacto';
      if (modalSubtitle) modalSubtitle.textContent = 'Ingresa los datos para registrar en el directorio de clientes';
      if (fId) fId.value = '';
      if (btnDeleteModal) btnDeleteModal.classList.add('hidden');
      if (btnSubmitModal) btnSubmitModal.textContent = 'Crear Contacto';
    }

    modal.showModal();
    fContacto?.focus();
  }

  btnNuevoContacto?.addEventListener('click', () => openContactoModal());
  btnCloseModal?.addEventListener('click', () => modal?.close());
  btnCancelModal?.addEventListener('click', () => modal?.close());

  // Clic en fila para abrir modal (excepto botón de WhatsApp)
  tbody?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-whatsapp-link]')) return;
    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowRecord) return;
    const record = JSON.parse(row.dataset.rowRecord) as ContactoRecord;
    openContactoModal(record);
  });

  // Filtros pills
  document.querySelectorAll<HTMLButtonElement>('[data-filter-pill]').forEach((pill) => {
    pill.addEventListener('click', () => {
      const targetFilter = pill.dataset.filterPill || 'ALL';
      selectedFilter = selectedFilter === targetFilter && targetFilter !== 'ALL' ? 'ALL' : targetFilter;
      applyFilters();
    });
  });

  // Selector desplegable de filtro junto al buscador
  selectFiltro?.addEventListener('change', () => {
    selectedFilter = selectFiltro.value || 'ALL';
    applyFilters();
  });

  // Botón rápido "Sin Teléfono" junto al buscador
  btnToggleSinTel?.addEventListener('click', () => {
    selectedFilter = selectedFilter === 'SIN_TEL' ? 'ALL' : 'SIN_TEL';
    applyFilters();
  });

  // Botón limpiar filtros
  btnResetFiltro?.addEventListener('click', () => {
    selectedFilter = 'ALL';
    if (searchInput) searchInput.value = '';
    applyFilters();
  });

  searchInput?.addEventListener('input', applyFilters);

  // Eliminar Contacto
  btnDeleteModal?.addEventListener('click', async () => {
    const idVal = fId?.value?.trim();
    if (!idVal) return;
    const id = Number(idVal);

    if (!window.confirm(`¿Estás seguro de eliminar el contacto #${id} de la base de datos D1?`)) {
      return;
    }

    btnDeleteModal.disabled = true;
    try {
      const response = await fetch(`/api/contactos?id=${id}`, { method: 'DELETE' });
      if (response.ok) {
        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${id}"]`);
        row?.remove();
        recalculateStats();
        applyFilters();
        modal?.close();
        showSyncToast(`Contacto #${id} eliminado de D1`);
      }
    } finally {
      btnDeleteModal.disabled = false;
    }
  });

  // Guardar Cambios o Crear Contacto
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btnSubmitModal) return;

    const idVal = fId?.value?.trim();
    const contacto = fContacto?.value?.trim();
    if (!contacto) {
      alert('El nombre o identificador del cliente/contacto es obligatorio.');
      fContacto?.focus();
      return;
    }

    const payload = {
      ...(idVal ? { id: Number(idVal) } : {}),
      contacto,
      telefono: fTelefono?.value?.trim() || '-',
      email: fEmail?.value?.trim() || '-',
      nombres: fNombres?.value?.trim() || '-',
      apellidos: fApellidos?.value?.trim() || '-',
      fecha_nacimiento: fNacimiento?.value?.trim() || '-',
      genero: fGenero?.value || '-',
      numero_pasaporte: fPasaporte?.value?.trim() || '-',
      nacionalidad_pasaporte: fNacionalidad?.value?.trim() || '-',
      fecha_emision_pasaporte: fEmision?.value?.trim() || '-',
      fecha_vencimiento_pasaporte: fVencimiento?.value?.trim() || '-',
    };

    btnSubmitModal.disabled = true;
    btnSubmitModal.textContent = 'Guardando...';

    try {
      const method = idVal ? 'PATCH' : 'POST';
      const response = await fetch('/api/contactos', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as { ok?: boolean; data?: ContactoRecord };

      if (response.ok && result.ok && result.data) {
        const updated = result.data;

        if (!idVal) {
          modal?.close();
          window.location.reload();
          return;
        }

        const row = tbody?.querySelector<HTMLTableRowElement>(`tr[data-row-id="${updated.id}"]`);
        if (row) {
          row.dataset.rowRecord = JSON.stringify(updated);
          row.dataset.rowContacto = updated.contacto;
          row.dataset.rowTel = updated.telefono;
          row.dataset.rowHasTel = updated.telefono && updated.telefono !== '-' ? '1' : '0';
          row.dataset.rowHasPas = updated.numero_pasaporte && updated.numero_pasaporte !== '-' ? '1' : '0';
          row.dataset.rowHasEmail = updated.email && updated.email !== '-' ? '1' : '0';

          const cellContacto = row.querySelector<HTMLElement>(`[data-cell-contacto="${updated.id}"]`);
          const cellTelefono = row.querySelector<HTMLElement>(`[data-cell-telefono="${updated.id}"]`);
          const cellEmail = row.querySelector<HTMLElement>(`[data-cell-email="${updated.id}"]`);
          const cellFullname = row.querySelector<HTMLElement>(`[data-cell-fullname="${updated.id}"]`);
          const cellGenero = row.querySelector<HTMLElement>(`[data-cell-genero="${updated.id}"]`);
          const cellPasaporte = row.querySelector<HTMLElement>(`[data-cell-pasaporte="${updated.id}"]`);
          const cellVencimiento = row.querySelector<HTMLElement>(`[data-cell-vencimiento="${updated.id}"]`);

          const nameSpan = row.querySelector<HTMLElement>(`[data-name-for="${updated.id}"]`);
          const waAnchor = row.querySelector<HTMLAnchorElement>(`[data-wa-for="${updated.id}"]`);
          if (nameSpan) {
            nameSpan.textContent = updated.contacto;
          } else if (cellContacto) {
            cellContacto.textContent = updated.contacto;
          }
          if (waAnchor) {
            const newWa = buildWhatsAppDynamicLink(updated.contacto, updated.telefono);
            waAnchor.href = newWa.url;
            waAnchor.title = newWa.label;
            waAnchor.setAttribute('aria-label', newWa.label);
          }
          if (cellTelefono) {
            cellTelefono.innerHTML =
              updated.telefono !== '-'
                ? `<span class="text-primary font-mono">${updated.telefono}</span>`
                : `<span class="text-primary/40 font-normal">-</span>`;
          }
          if (cellEmail) {
            cellEmail.innerHTML =
              updated.email !== '-'
                ? `<span class="text-blue-600 font-medium">${updated.email}</span>`
                : `<span class="text-primary/40 font-normal">-</span>`;
          }
          if (cellFullname) {
            const fn =
              updated.nombres !== '-' || updated.apellidos !== '-'
                ? `${updated.nombres !== '-' ? updated.nombres : ''} ${updated.apellidos !== '-' ? updated.apellidos : ''}`.trim()
                : '-';
            cellFullname.textContent = fn;
          }
          if (cellGenero) cellGenero.textContent = updated.genero;
          if (cellPasaporte) {
            cellPasaporte.innerHTML =
              updated.numero_pasaporte !== '-'
                ? `<div class="flex items-center gap-1.5"><span class="text-secondary">${updated.numero_pasaporte}</span>${
                    updated.nacionalidad_pasaporte !== '-'
                      ? `<span class="text-[10px] uppercase font-sans font-bold bg-primary/10 text-primary px-1.5 py-0.5 rounded">${updated.nacionalidad_pasaporte}</span>`
                      : ''
                  }</div>`
                : `<span class="text-primary/40 font-normal font-sans">-</span>`;
          }
          if (cellVencimiento) cellVencimiento.textContent = updated.fecha_vencimiento_pasaporte;
        }

        recalculateStats();
        applyFilters();
        modal?.close();
        showSyncToast(`Contacto #${updated.id} guardado en D1`);
      } else {
        alert('Error al guardar el contacto.');
      }
    } catch {
      alert('Error de conexión al guardar el contacto.');
    } finally {
      btnSubmitModal.disabled = false;
      btnSubmitModal.textContent = 'Guardar Cambios';
    }
  });
</script>
