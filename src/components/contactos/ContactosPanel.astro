---
import { CONTACTOS_GRID_COLUMNS } from '@/constants/site';
import type { ContactoRecord, PendienteRecord } from '@/types';
import { createMidnightDate, evaluatePendienteForHoy } from '@/utils/flightDateHelpers';
import { buildWhatsAppDynamicLink, normalizePhoneForWhatsApp } from '@/utils/pagoHelpers';

interface Props {
  contactos: ContactoRecord[];
  pendientes?: PendienteRecord[];
}

const { contactos, pendientes = [] } = Astro.props;

const now = new Date();
const serverRefDate = createMidnightDate(now.getFullYear(), now.getMonth() + 1, now.getDate());

function normStr(s: string | null | undefined): string {
  return (s || '').trim().toLowerCase().replace(/\s+/g, ' ');
}

function getContactPendientes(c: ContactoRecord): PendienteRecord[] {
  if (!pendientes || pendientes.length === 0) return [];
  const cNorm = normStr(c.contacto);
  const fullName = [
    c.nombres && c.nombres !== '-' ? c.nombres.trim() : '',
    c.apellidos && c.apellidos !== '-' ? c.apellidos.trim() : '',
  ]
    .filter(Boolean)
    .join(' ');
  const fullNorm = normStr(fullName);
  const cPhone = normalizePhoneForWhatsApp(c.telefono);
  const cContactPhone = normalizePhoneForWhatsApp(c.contacto);

  return pendientes.filter((p) => {
    const pNorm = normStr(p.contacto);
    if (pNorm && (pNorm === cNorm || (fullNorm && pNorm === fullNorm))) {
      return true;
    }
    const pPhone = normalizePhoneForWhatsApp(p.contacto);
    if (pPhone.length >= 7 && (pPhone === cPhone || pPhone === cContactPhone)) {
      return true;
    }
    return false;
  });
}

function isPhoneLikeText(val: string | undefined | null): boolean {
  const s = (val || '').trim();
  if (!s || s === '-') return false;
  return /^[\d\s\+\-\(\)\.]+$/.test(s);
}

function isContactoSinNombre(c: Partial<ContactoRecord>): boolean {
  const contactoStr = (c.contacto || '').trim();
  const telStr = (c.telefono || '').trim();
  const nombresStr = (c.nombres || '').trim();
  const apellidosStr = (c.apellidos || '').trim();

  const hasValidNombres = Boolean(nombresStr && nombresStr !== '-' && !isPhoneLikeText(nombresStr));
  const hasValidApellidos = Boolean(apellidosStr && apellidosStr !== '-' && !isPhoneLikeText(apellidosStr));

  // Si el identificador principal (Cliente / Contacto) es solo números/teléfono o igual al teléfono, no tiene nombre guardado
  if (!contactoStr || contactoStr === '-' || isPhoneLikeText(contactoStr)) return true;
  if (telStr && telStr !== '-' && contactoStr.toLowerCase() === telStr.toLowerCase()) return true;

  // Si después de quitar el teléfono del campo contacto no queda ninguna letra y tampoco tiene Nombres/Apellidos
  const contactoWithoutPhone = telStr && telStr !== '-' ? contactoStr.replace(telStr, '').trim() : contactoStr;
  const hasLettersInContacto = /[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ]{2,}/.test(contactoWithoutPhone);
  if (!hasLettersInContacto && !hasValidNombres && !hasValidApellidos) return true;

  return false;
}

const totalContactos = contactos.length;
const conTelefono = contactos.filter((c) => c.telefono && c.telefono.trim() !== '-' && c.telefono.trim() !== '').length;
const sinTelefono = totalContactos - conTelefono;
const sinNombre = contactos.filter((c) => isContactoSinNombre(c)).length;
const conPasaporte = contactos.filter((c) => c.numero_pasaporte && c.numero_pasaporte !== '-').length;
const conEmail = contactos.filter((c) => c.email && c.email !== '-').length;
const totalVip = contactos.filter((c) => (c.tipo_cliente || '-') === 'VIP').length;
const totalSecundario = contactos.filter((c) => (c.tipo_cliente || '-') === 'Secundario').length;
const totalPapeamento = contactos.filter((c) => (c.tipo_cliente || '-') === 'Papeamento/Ingles').length;
const totalMenor = contactos.filter((c) => (c.tipo_cliente || '-') === 'Menor importancia').length;

function getTipoClienteBadgeClass(tipo?: string): string {
  switch ((tipo || '-').trim()) {
    case 'VIP':
      return 'bg-emerald-800 text-white border border-emerald-950';
    case 'Secundario':
      return 'bg-purple-600 text-white border border-purple-700';
    case 'Papeamento/Ingles':
      return 'bg-blue-950 text-white border border-blue-950';
    case 'Menor importancia':
      return 'bg-slate-200 text-slate-700 border border-slate-300';
    default:
      return 'hidden';
  }
}
---

<section class="flex-1 min-h-0 flex flex-col w-full max-w-[1440px] lg:w-[92%] xl:w-[88%] mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 gap-3">
  <!-- Barra principal limpia: Buscador amplio a la izquierda + Nuevo Contacto y Menú Hamburguesa a la derecha -->
  <div class="shrink-0 relative z-30 bg-base rounded-xl border border-base-border p-3.5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <!-- Buscador amplio a la izquierda -->
    <div class="flex flex-1 items-center gap-3 min-w-0">
      <div class="relative w-full flex-1 min-w-0 max-w-2xl">
        <input
          type="search"
          id="input-search-contactos"
          placeholder="Buscar por cliente, teléfono, nombres, pasaporte..."
          class="w-full rounded-lg border border-base-border bg-base-muted px-4 py-2 text-sm text-primary placeholder:text-primary/50 focus:border-primary focus:bg-base focus:outline-none"
        />
      </div>
      <span
        id="d1-sync-toast"
        class="hidden rounded-md bg-emerald-50 text-emerald-800 border border-emerald-300 px-2.5 py-1 text-xs font-bold transition whitespace-nowrap shrink-0"
      >
        Guardado en D1
      </span>
    </div>

    <!-- Botones a la derecha: Nuevo Contacto + Hamburguesa de Filtros -->
    <div class="relative flex flex-wrap items-center gap-2 shrink-0">
      <button
        type="button"
        id="btn-nuevo-contacto"
        class="rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-base font-bold px-4 py-2 text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer"
      >
        <span>+</span>
        <span>Nuevo Contacto</span>
      </button>

      <!-- Botón Hamburguesa que desglosa la lista de tipos de filtro -->
      <button
        type="button"
        id="btn-toggle-hamburger-contactos"
        aria-expanded="false"
        title="Abrir lista de filtros de Contactos"
        class="rounded-lg border-2 border-primary/30 bg-base-muted hover:border-primary hover:bg-primary hover:text-base text-primary font-extrabold px-3.5 py-2 text-xs shadow-xs transition flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span id="label-hamburger-contactos">Filtros</span>
        <span
          id="badge-hamburger-contactos"
          class="hidden items-center justify-center rounded-full bg-amber-500 text-white px-1.5 py-0.5 text-[10px] font-extrabold leading-none"
        >
          1
        </span>
      </button>

      <!-- Menú Hamburguesa desplegable en lista vertical con los tipos de filtro -->
      <div
        id="panel-filtros-contactos"
        class="hidden absolute right-0 top-full mt-2 z-50 w-72 sm:w-80 max-h-[calc(100dvh-9rem)] overflow-y-auto overscroll-contain bg-base rounded-xl border-2 border-primary/25 p-3 shadow-xl transition-all"
      >
        <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-base-border">
          <span class="text-xs font-extrabold uppercase tracking-wider text-primary">
            🔎 Filtrar Contactos
          </span>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="btn-reset-filtro-contactos"
              title="Restablecer búsqueda y filtros"
              class="rounded-lg border border-sky-300 bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold px-2.5 py-1 text-xs transition cursor-pointer"
            >
              Limpiar
            </button>
            <button
              type="button"
              id="btn-close-hamburger-contactos"
              title="Cerrar menú de filtros"
              aria-label="Cerrar menú de filtros"
              class="rounded-lg border border-base-border bg-base-muted hover:bg-base text-primary/80 font-extrabold px-2.5 py-1 text-xs leading-none transition cursor-pointer"
            >
              ✕
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <!-- 1. Todos los contactos (Azul) -->
          <button
            type="button"
            data-filter-pill="ALL"
            class="w-full rounded-lg border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>👥</span>
              <span>Todos los contactos</span>
            </span>
            <span id="menu-stat-total" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-primary">{totalContactos}</span>
          </button>

          <!-- 2. Sin nombre (Rojo) -->
          <button
            type="button"
            id="btn-toggle-sin-nombre"
            data-filter-pill="SIN_NOMBRE"
            title="Filtrar contactos que no tienen nombre guardado (su nombre es el mismo número de teléfono)"
            class="w-full rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>👤</span>
              <span>Sin nombre</span>
            </span>
            <span id="btn-stat-sin-nombre" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-secondary">{sinNombre}</span>
          </button>

          <!-- 3. Sin teléfono (Naranja) -->
          <button
            type="button"
            id="btn-toggle-sin-telefono"
            data-filter-pill="SIN_TEL"
            class="w-full rounded-lg border border-orange-300 bg-orange-50 hover:bg-orange-100 text-orange-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>📵</span>
              <span>Sin teléfono</span>
            </span>
            <span id="btn-stat-sin-tel" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-orange-800">{sinTelefono}</span>
          </button>

          <!-- 4. Sin pasaporte (Amarillo) -->
          <button
            type="button"
            data-filter-pill="SIN_PAS"
            class="w-full rounded-lg border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>⚠️</span>
              <span>Sin pasaporte</span>
            </span>
            <span id="menu-stat-sin-pas" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-amber-800">{totalContactos - conPasaporte}</span>
          </button>

          <!-- 5. Con Email (Verde) -->
          <button
            type="button"
            data-filter-pill="CON_EMAIL"
            class="w-full rounded-lg border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>✉️</span>
              <span>Con Email</span>
            </span>
            <span id="menu-stat-email" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-emerald-800">{conEmail}</span>
          </button>

          <div class="my-1 border-t border-base-border pt-1.5">
            <span class="block px-1 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-primary/60">
              Tipo de Cliente
            </span>
          </div>

          <!-- 6. VIP (Verde oscuro) -->
          <button
            type="button"
            data-filter-pill="TIPO_VIP"
            class="w-full rounded-lg border border-emerald-950 bg-emerald-800 hover:bg-emerald-900 text-white font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left shadow-2xs"
          >
            <span class="flex items-center gap-2">
              <span>⭐</span>
              <span>VIP</span>
            </span>
            <span id="menu-stat-vip" class="rounded bg-white/95 px-2 py-0.5 text-[11px] font-extrabold text-emerald-950">{totalVip}</span>
          </button>

          <!-- 7. Secundario (Morado) -->
          <button
            type="button"
            data-filter-pill="TIPO_SECUNDARIO"
            class="w-full rounded-lg border border-purple-300 bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>🟣</span>
              <span>Secundario</span>
            </span>
            <span id="menu-stat-secundario" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-purple-900">{totalSecundario}</span>
          </button>

          <!-- 8. Papeamento/Ingles (Azul oscuro) -->
          <button
            type="button"
            data-filter-pill="TIPO_PAPEAMENTO"
            class="w-full rounded-lg border border-blue-950 bg-blue-950 hover:bg-blue-900 text-white font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left shadow-2xs"
          >
            <span class="flex items-center gap-2">
              <span>🌐</span>
              <span>Papeamento/Ingles</span>
            </span>
            <span id="menu-stat-papeamento" class="rounded bg-white/95 px-2 py-0.5 text-[11px] font-extrabold text-blue-950">{totalPapeamento}</span>
          </button>

          <!-- 9. Menor importancia -->
          <button
            type="button"
            data-filter-pill="TIPO_MENOR"
            class="w-full rounded-lg border border-slate-300 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-3 py-2 text-xs transition cursor-pointer flex items-center justify-between gap-2 text-left"
          >
            <span class="flex items-center gap-2">
              <span>🔹</span>
              <span>Menor importancia</span>
            </span>
            <span id="menu-stat-menor" class="rounded bg-white/90 px-2 py-0.5 text-[11px] font-extrabold text-slate-700">{totalMenor}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla de Contactos -->
  <div class="flex-1 min-h-0 flex flex-col bg-base rounded-xl border border-base-border shadow-xs overflow-hidden">
    <div
      tabindex="0"
      role="region"
      aria-labelledby="contactos-table-caption"
      class="table-wrapper"
    >
      <table class="clientes-table contactos-table text-left text-sm">
        <caption id="contactos-table-caption" class="sr-only">
          Directorio general de clientes y pasaportes de Global Travel CW
        </caption>
        <thead class="bg-primary text-base text-xs uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3 px-4 font-bold border-b-2 border-secondary w-[42%]">
              {CONTACTOS_GRID_COLUMNS.contacto}
            </th>
            <th scope="col" class="py-3 px-4 font-bold border-b-2 border-secondary text-center w-[22%]">
              Tipo de Cliente
            </th>
            <th scope="col" class="py-3 px-4 font-bold border-b-2 border-secondary w-[36%]">
              {CONTACTOS_GRID_COLUMNS.telefono}
            </th>
          </tr>
        </thead>
        <tbody id="contactos-tbody" class="divide-y divide-base-border">
          {
            contactos.map((c) => {
              const waInfo = buildWhatsAppDynamicLink(c.contacto, c.telefono);
              const tipoClienteVal = (c.tipo_cliente || '-').trim();
              const hasTipoBadge = tipoClienteVal && tipoClienteVal !== '-';
              const matchedPendientes = getContactPendientes(c);
              const hasPendiente = matchedPendientes.length > 0;
              const hoyMatches = matchedPendientes
                .map((p) => ({ p, eval: evaluatePendienteForHoy(p, serverRefDate) }))
                .filter((item) => item.eval.matches);
              const hasPendienteHoy = hoyMatches.length > 0;
              const targetPendienteQuery = matchedPendientes[0]?.contacto || c.contacto;
              const hoyLabels = hoyMatches.map((m) => m.eval.matchLabel).join(' | ');
              return (
                <tr
                  tabindex="0"
                  role="button"
                  aria-label={`Abrir ficha de contacto de ${c.contacto}`}
                  data-row-id={c.id}
                  data-row-contacto={c.contacto}
                  data-row-tel={c.telefono}
                  data-row-has-tel={c.telefono && c.telefono !== '-' ? '1' : '0'}
                  data-row-sin-nombre={isContactoSinNombre(c) ? '1' : '0'}
                  data-row-has-pas={c.numero_pasaporte && c.numero_pasaporte !== '-' ? '1' : '0'}
                  data-row-has-email={c.email && c.email !== '-' ? '1' : '0'}
                  data-row-tipo-cliente={tipoClienteVal || '-'}
                  data-row-record={JSON.stringify(c)}
                  data-row-pendientes={hasPendiente ? JSON.stringify(matchedPendientes) : ''}
                  class="hover:bg-base-muted focus:bg-base-muted focus:outline-none transition-colors cursor-pointer"
                >
                  <th
                    scope="row"
                    data-cell-contacto={c.id}
                    class="py-2.5 px-4 font-bold text-primary border-r border-base-border align-middle"
                  >
                    <span data-name-for={c.id} class="text-sm leading-snug">{c.contacto}</span>
                  </th>

                  <td
                    data-cell-tipo-cliente={c.id}
                    class="py-2.5 px-4 text-center border-r border-base-border align-middle whitespace-nowrap"
                  >
                    <span
                      data-tipo-badge-for={c.id}
                      class={`inline-flex items-center justify-center rounded-md px-2.5 py-0.5 text-[11px] font-extrabold tracking-wide leading-tight ${
                        hasTipoBadge ? getTipoClienteBadgeClass(tipoClienteVal) : 'hidden'
                      }`}
                    >
                      {hasTipoBadge ? tipoClienteVal : ''}
                    </span>
                    <span
                      data-tipo-placeholder-for={c.id}
                      class={hasTipoBadge ? 'hidden' : 'text-xs text-primary/40 font-normal'}
                    >
                      -
                    </span>
                  </td>

                  <td
                    data-cell-telefono={c.id}
                    class="py-2.5 px-4 align-middle text-xs font-semibold text-primary/90 whitespace-nowrap"
                  >
                    <div class="flex items-center justify-between gap-3 flex-1 w-full">
                      <span data-tel-text-for={c.id}>
                        {c.telefono !== '-' ? (
                          <span class="text-primary font-mono">{c.telefono}</span>
                        ) : (
                          <span class="text-primary/40 font-normal">-</span>
                        )}
                      </span>

                      <div class="flex items-center gap-1.5 shrink-0 ml-auto">
                        <a
                          href={`/pendientes-hoy?contacto=${encodeURIComponent(targetPendienteQuery)}`}
                          data-pendiente-hoy-link="true"
                          data-hoy-for={c.id}
                          title={
                            hasPendienteHoy
                              ? `Pendiente para HOY (${hoyLabels}) — Ir a Pendientes Hoy`
                              : 'Pendiente para Hoy'
                          }
                          aria-label={`Ver pendiente de hoy de ${c.contacto}`}
                          class={`${
                            hasPendienteHoy ? 'inline-flex' : 'hidden'
                          } items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white shadow-xs transition transform hover:scale-105`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                            <path d="M12 14v4" />
                            <path d="M12 14h2" />
                          </svg>
                        </a>

                        {hasPendiente && (
                          <a
                            href={`/?contacto=${encodeURIComponent(targetPendienteQuery)}`}
                            data-pendiente-link="true"
                            data-pendiente-for={c.id}
                            title={`Ir al pendiente de ${c.contacto} (${matchedPendientes.length} pendiente${matchedPendientes.length > 1 ? 's' : ''})`}
                            aria-label={`Ir al pendiente de ${c.contacto}`}
                            class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-white shadow-xs transition transform hover:scale-105"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                              <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                              <rect x="9" y="3" width="6" height="4" rx="1" />
                              <path d="M9 12h6" />
                              <path d="M9 16h4" />
                            </svg>
                          </a>
                        )}

                        <a
                          href={waInfo.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-whatsapp-link="true"
                          data-wa-for={c.id}
                          title={waInfo.label}
                          aria-label={waInfo.label}
                          class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white shadow-xs transition transform hover:scale-105"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.531 5.86L0 24l6.335-1.652c1.688.919 3.621 1.444 5.666 1.444 6.627 0 12-5.373 12-12s-5.373-12-11.993-12z"/></svg>
                        </a>
                        <button
                          type="button"
                          data-delete-contacto={c.id}
                          data-delete-name={c.contacto}
                          title={`Eliminar contacto de ${c.contacto}`}
                          aria-label={`Eliminar contacto de ${c.contacto}`}
                          class="inline-flex items-center justify-center shrink-0 h-8 w-8 rounded-lg bg-secondary/10 border border-secondary/40 text-secondary hover:bg-secondary hover:text-base active:bg-secondary-dark shadow-xs transition cursor-pointer"
                        >
