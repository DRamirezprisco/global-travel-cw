        <!-- Pasaporte: Fecha Vencimiento -->
        <div>
          <label for="field-contacto-vencimiento" class="block text-xs font-bold uppercase text-primary mb-1">
            Fecha Vencimiento Pasaporte
          </label>
          <input
            type="text"
            id="field-contacto-vencimiento"
            name="fecha_vencimiento_pasaporte"
            placeholder="DD/MM/AAAA"
            class="w-full rounded-lg border border-base-border bg-base-muted px-3 py-2 text-primary focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="shrink-0 flex flex-wrap items-center justify-between gap-3 bg-base-muted px-6 py-3.5 border-t border-base-border">
      <div>
        <button
          type="button"
          id="btn-delete-modal-contacto"
          class="inline-flex items-center gap-1.5 rounded-lg bg-secondary/10 border border-secondary px-4 py-2 text-xs font-extrabold text-secondary hover:bg-secondary hover:text-base transition cursor-pointer"
        >
          Eliminar Contacto
        </button>
      </div>

      <div class="flex items-center gap-2.5 ml-auto">
        <button
          type="button"
          id="btn-cancel-modal-contacto"
          class="rounded-lg border border-base-border bg-base px-4 py-2 text-xs font-semibold text-primary hover:bg-base-muted transition cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-modal-contacto"
          class="rounded-lg bg-primary hover:bg-primary-light active:bg-primary-dark text-base font-bold px-5 py-2 text-xs shadow-xs transition cursor-pointer"
