---
import type { EstatusRecord } from '@/types';

interface Props {
  estatusList: EstatusRecord[];
}

const { estatusList = [] } = Astro.props;

const PRESET_COLORS = [
  { name: 'Rojo', hex: '#ff0000' },
  { name: 'Ámbar', hex: '#ffc000' },
  { name: 'Azul Cielo', hex: '#00b0f0' },
  { name: 'Verde Lima', hex: '#00ff00' },
  { name: 'Magenta', hex: '#cc3399' },
  { name: 'Verde Oliva', hex: '#669900' },
  { name: 'Fucsia', hex: '#ff0066' },
  { name: 'Esmeralda', hex: '#059669' },
  { name: 'Azul Rey', hex: '#1e3a8a' },
  { name: 'Púrpura', hex: '#7c3aed' },
  { name: 'Naranja', hex: '#ea580c' },
  { name: 'Rosa', hex: '#db2777' },
  { name: 'Turquesa', hex: '#0d9488' },
  { name: 'Gris Pizarra', hex: '#475569' },
];
---

<section class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-4">
  <!-- Barra superior con Botón Nuevo Estatus -->
  <div class="flex items-center justify-between">
    <h1 class="text-xl sm:text-2xl font-black text-primary tracking-tight">
      Estatus
    </h1>
    <button
      type="button"
      id="btn-nuevo-estatus"
      class="inline-flex items-center gap-2 rounded-lg bg-primary hover:bg-primary-light text-base px-4 py-2 text-sm font-bold shadow-xs transition cursor-pointer"
    >
      <span class="text-lg leading-none font-black">+</span>
      <span>Nuevo Estatus</span>
    </button>
  </div>

  <!-- Tabla de Estatus (Sencilla: Color, Nombre del Estatus, Código) -->
  <div class="bg-base rounded-xl border border-base-border shadow-xs overflow-hidden">
    <div class="table-wrapper">
      <table class="w-full text-left text-sm border-collapse">
        <thead class="bg-primary text-base text-xs uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-6 font-bold border-b-2 border-secondary w-44">
              Color
            </th>
            <th scope="col" class="py-3.5 px-6 font-bold border-b-2 border-secondary min-w-[260px]">
              Nombre del Estatus
            </th>
            <th scope="col" class="py-3.5 px-6 font-bold border-b-2 border-secondary min-w-[200px]">
              Código (Slug)
            </th>
          </tr>
        </thead>
        <tbody id="tbody-estatus" class="divide-y divide-base-border bg-base font-medium">
          {
            estatusList.map((item) => {
              const hex = item.color || '#1e3a8a';
              return (
                <tr
                  tabindex="0"
                  role="button"
                  aria-label={`Editar estatus ${item.nombre}`}
                  data-row-id={item.id}
                  data-row-data={JSON.stringify(item)}
                  class="hover:bg-base-muted focus:bg-base-muted focus:outline-none transition-colors cursor-pointer"
                >
                  <!-- Color -->
                  <td class="py-3.5 px-6 align-middle">
                    <div class="flex items-center gap-3">
                      <span
                        data-cell-color-circle={item.id}
                        class="h-6 w-6 rounded-full border-2 border-white shadow-xs shrink-0 ring-1 ring-base-border"
                        style={`background-color: ${hex};`}
                      />
                      <span
                        data-cell-color-hex={item.id}
                        class="text-xs font-mono font-bold uppercase text-primary/80"
                      >
                        {hex}
                      </span>
                    </div>
                  </td>

                  <!-- Nombre y Preview de Badge -->
                  <td class="py-3.5 px-6 align-middle">
                    <div class="flex items-center gap-3">
                      <span data-cell-nombre={item.id} class="font-extrabold text-primary text-sm">
                        {item.nombre}
                      </span>
                      <span
                        data-cell-badge-preview={item.id}
                        class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold border w-fit"
                        style={`background-color: ${hex}18; color: ${hex}; border-color: ${hex}55;`}
                      >
                        <span
                          class="h-2 w-2 rounded-full shrink-0"
                          style={`background-color: ${hex};`}
                        />
                        <span>{item.nombre}</span>
                      </span>
                    </div>
                  </td>

                  <!-- Código (Slug) -->
                  <td class="py-3.5 px-6 align-middle">
                    <span
                      data-cell-codigo={item.id}
                      class="inline-block bg-base-muted text-primary/90 border border-base-border px-2.5 py-1 rounded-md text-xs font-mono font-semibold"
                    >
                      {item.codigo}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Ventana Modal para Crear, Editar o Eliminar Estatus -->
<dialog
  id="modal-estatus"
  aria-labelledby="modal-estatus-title"
  {...({ closedby: 'any' } as any)}
  class="m-auto w-full max-w-lg rounded-2xl border-2 border-primary bg-base p-0 text-primary shadow-2xl backdrop:bg-primary-dark/60"
>
  <form id="form-estatus" class="flex flex-col">
    <!-- Cabecera del Modal -->
    <div class="flex items-center justify-between bg-primary px-6 py-4 text-base border-b-4 border-secondary">
      <div>
        <h3 id="modal-estatus-title" class="text-base sm:text-lg font-extrabold">
          Editar Estatus
        </h3>
        <p id="modal-estatus-subtitle" class="text-xs text-base-muted opacity-85 mt-0.5">
          Configura nombre, código identificador y color para Pendientes
        </p>
      </div>
      <button
        type="button"
        id="btn-close-modal-estatus"
        class="rounded-lg bg-primary-dark px-3 py-1.5 text-xs font-bold text-base hover:bg-secondary transition cursor-pointer"
      >
        Cerrar ✕
      </button>
    </div>

    <!-- Cuerpo del Formulario -->
    <div class="p-6 space-y-4 text-sm max-h-[75vh] overflow-y-auto">
      <input type="hidden" id="field-estatus-id" name="id" value="" />

      <!-- Nombre -->
      <div>
        <label for="field-estatus-nombre" class="block text-xs font-bold uppercase text-primary mb-1">
          Nombre del Estatus *
        </label>
        <input
          type="text"
          id="field-estatus-nombre"
          name="nombre"
          required
          placeholder="Ej. Revisión de Documentos, En Espera..."
          class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 text-primary font-bold focus:border-primary focus:bg-base focus:outline-none"
        />
      </div>

      <!-- Código -->
      <div>
        <label for="field-estatus-codigo" class="block text-xs font-bold uppercase text-primary mb-1">
          Código / Slug (Identificador Único) *
        </label>
        <input
          type="text"
          id="field-estatus-codigo"
          name="codigo"
          required
          placeholder="Ej. revision-documentos"
          class="w-full rounded-lg border border-base-border bg-base-muted px-3.5 py-2 font-mono text-sm text-primary focus:border-primary focus:bg-base focus:outline-none"
        />
      </div>

      <!-- Color -->
      <div>
        <label for="field-estatus-color" class="block text-xs font-bold uppercase text-primary mb-1">
          Color *
        </label>
        <div class="flex items-center gap-3">
          <input
            type="color"
            id="field-estatus-color-picker"
            value="#ff0000"
            class="h-10 w-12 rounded-lg border border-base-border bg-base-muted p-1 cursor-pointer"
          />
          <input
            type="text"
            id="field-estatus-color"
            name="color"
            required
            maxlength="9"
            placeholder="#FF0000"
            class="flex-1 rounded-lg border border-base-border bg-base-muted px-3.5 py-2 font-mono text-sm uppercase text-primary font-bold focus:border-primary focus:bg-base focus:outline-none"
          />
        </div>

        <!-- Paleta Rápida -->
        <div class="mt-3">
          <p class="text-xs font-semibold text-primary/70 mb-1.5">Colores recomendados:</p>
          <div class="flex flex-wrap gap-2">
            {
              PRESET_COLORS.map((preset) => (
                <button
                  type="button"
                  data-preset-color={preset.hex}
                  title={`${preset.name} (${preset.hex})`}
                  class="preset-color-btn h-7 w-7 rounded-full border-2 border-white shadow-xs ring-1 ring-base-border hover:scale-110 transition cursor-pointer"
                  style={`background-color: ${preset.hex};`}
                />
              ))
            }
          </div>
        </div>
      </div>

      <!-- Live Preview -->
      <div class="pt-3 border-t border-base-border">
        <label class="block text-xs font-bold uppercase text-primary/70 mb-2">
          Vista Previa
        </label>
        <div class="p-3.5 rounded-xl bg-base-muted border border-base-border flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span
              id="preview-dot"
              class="h-3 w-3 rounded-full"
              style="background-color: #ff0000;"
            ></span>
            <span id="preview-title" class="font-bold text-primary text-sm">
              Nombre de Estatus
            </span>
          </div>

          <span
            id="preview-badge"
            class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold border transition"
            style="background-color: #ff000018; color: #ff0000; border-color: #ff000060;"
          >
            <span
              id="preview-badge-dot"
              class="h-2 w-2 rounded-full shrink-0"
              style="background-color: #ff0000;"
            ></span>
            <span id="preview-badge-text">Nombre de Estatus</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Pie del Modal: Eliminar a la izquierda, Cancelar y Guardar a la derecha -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-base-muted px-6 py-4 border-t border-base-border">
      <div>
        <button
          type="button"
          id="btn-delete-modal-estatus"
          class="inline-flex items-center gap-1.5 rounded-lg bg-secondary/10 border border-secondary px-4 py-2 text-xs font-extrabold text-secondary hover:bg-secondary hover:text-base transition cursor-pointer"
        >
          Eliminar Estatus
        </button>
      </div>

      <div class="flex items-center gap-2.5 ml-auto">
        <button
          type="button"
          id="btn-cancel-modal-estatus"
          class="rounded-lg border border-base-border bg-base px-4 py-2 text-xs font-bold text-primary hover:bg-base-muted cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btn-submit-modal-estatus"
          class="rounded-lg bg-primary hover:bg-primary-light px-5 py-2 text-xs font-extrabold text-base shadow-xs transition cursor-pointer disabled:opacity-50"
        >
          Guardar Cambios
        </button>
      </div>
    </div>
  </form>
</dialog>

<script>
  import type { EstatusRecord } from '@/types';

  const modal = document.querySelector<HTMLDialogElement>('#modal-estatus');
  const form = document.querySelector<HTMLFormElement>('#form-estatus');
  const btnNuevo = document.querySelector<HTMLButtonElement>('#btn-nuevo-estatus');
  const btnClose = document.querySelector<HTMLButtonElement>('#btn-close-modal-estatus');
  const btnCancel = document.querySelector<HTMLButtonElement>('#btn-cancel-modal-estatus');
  const btnDelete = document.querySelector<HTMLButtonElement>('#btn-delete-modal-estatus');
  const btnSubmit = document.querySelector<HTMLButtonElement>('#btn-submit-modal-estatus');
  const modalTitle = document.querySelector<HTMLElement>('#modal-estatus-title');
  const modalSubtitle = document.querySelector<HTMLElement>('#modal-estatus-subtitle');

  const fId = document.querySelector<HTMLInputElement>('#field-estatus-id');
  const fNombre = document.querySelector<HTMLInputElement>('#field-estatus-nombre');
  const fCodigo = document.querySelector<HTMLInputElement>('#field-estatus-codigo');
  const fColor = document.querySelector<HTMLInputElement>('#field-estatus-color');
  const fColorPicker = document.querySelector<HTMLInputElement>('#field-estatus-color-picker');

  const previewDot = document.querySelector<HTMLElement>('#preview-dot');
  const previewTitle = document.querySelector<HTMLElement>('#preview-title');
  const previewBadge = document.querySelector<HTMLElement>('#preview-badge');
  const previewBadgeDot = document.querySelector<HTMLElement>('#preview-badge-dot');
  const previewBadgeText = document.querySelector<HTMLElement>('#preview-badge-text');

  const tbody = document.querySelector<HTMLTableSectionElement>('#tbody-estatus');

  let activeRecord: EstatusRecord | null = null;
  let isAutoSlug = true;

  function slugify(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function updatePreview() {
    const nombre = fNombre?.value.trim() || 'Nombre de Estatus';
    const color = fColor?.value.trim() || '#ff0000';

    if (previewTitle) previewTitle.textContent = nombre;
    if (previewBadgeText) previewBadgeText.textContent = nombre;

    if (previewDot) {
      previewDot.style.backgroundColor = color;
    }
    if (previewBadge) {
      previewBadge.style.backgroundColor = `${color}18`;
      previewBadge.style.color = color;
      previewBadge.style.borderColor = `${color}60`;
    }
    if (previewBadgeDot) {
      previewBadgeDot.style.backgroundColor = color;
    }
  }

  function syncColor(val: string) {
    if (!val) return;
    if (!val.startsWith('#')) val = '#' + val;
    if (fColor) fColor.value = val;
    if (fColorPicker && /^#[0-9A-Fa-f]{6}$/.test(val)) {
      fColorPicker.value = val;
    }
    updatePreview();
  }

  fColor?.addEventListener('input', () => {
    syncColor(fColor.value);
  });

  fColorPicker?.addEventListener('input', () => {
    if (fColor) fColor.value = fColorPicker.value;
    updatePreview();
  });

  document.querySelectorAll<HTMLButtonElement>('.preset-color-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hex = btn.getAttribute('data-preset-color');
      if (hex) syncColor(hex);
    });
  });

  fNombre?.addEventListener('input', () => {
    if (isAutoSlug && fCodigo) {
      fCodigo.value = slugify(fNombre.value);
    }
    updatePreview();
  });

  fCodigo?.addEventListener('input', () => {
    isAutoSlug = false;
  });

  // Abrir modal para Crear Nuevo Estatus
  function openCreateModal() {
    if (!form || !modal) return;
    form.reset();
    activeRecord = null;
    isAutoSlug = true;
    if (fId) fId.value = '';
    if (fColor) fColor.value = '#ff0000';
    if (fColorPicker) fColorPicker.value = '#ff0000';
    if (modalTitle) modalTitle.textContent = 'Nuevo Estatus';
    if (modalSubtitle) modalSubtitle.textContent = 'Configura nombre, código identificador y color';
    if (btnDelete) btnDelete.classList.add('hidden');
    if (btnSubmit) btnSubmit.textContent = 'Crear Estatus';
    updatePreview();
    modal.showModal();
    fNombre?.focus();
  }

  // Abrir modal para Editar o Eliminar Estatus existente
  function openEditModal(record: EstatusRecord) {
    if (!form || !modal) return;
    form.reset();
    activeRecord = record;
    isAutoSlug = false;
    if (fId) fId.value = String(record.id);
    if (fNombre) fNombre.value = record.nombre;
    if (fCodigo) fCodigo.value = record.codigo;
    if (fColor) fColor.value = record.color;
    if (fColorPicker && /^#[0-9A-Fa-f]{6}$/.test(record.color)) {
      fColorPicker.value = record.color;
    }
    if (modalTitle) modalTitle.textContent = `Editar Estatus: ${record.nombre}`;
    if (modalSubtitle) modalSubtitle.textContent = 'Modifica los datos o elimina el estatus';
    if (btnDelete) btnDelete.classList.remove('hidden');
    if (btnSubmit) btnSubmit.textContent = 'Guardar Cambios';
    updatePreview();
    modal.showModal();
    fNombre?.focus();
  }

  btnNuevo?.addEventListener('click', openCreateModal);
  btnClose?.addEventListener('click', () => modal?.close());
  btnCancel?.addEventListener('click', () => modal?.close());

  // Clic en cualquier fila de la tabla abre el modal
  tbody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowData) return;

    try {
      const record = JSON.parse(row.dataset.rowData) as EstatusRecord;
      openEditModal(record);
    } catch {}
  });

  tbody?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target as HTMLElement;
    const row = target.closest<HTMLTableRowElement>('tr[data-row-id]');
    if (!row || !row.dataset.rowData) return;

    e.preventDefault();
    try {
      const record = JSON.parse(row.dataset.rowData) as EstatusRecord;
      openEditModal(record);
    } catch {}
  });

  // Eliminar desde el modal
  btnDelete?.addEventListener('click', async () => {
    if (!activeRecord) return;
    const id = activeRecord.id;
    const name = activeRecord.nombre;
    const count = Number(activeRecord.total_pendientes) || 0;

    if (count > 0) {
      alert(
        `No es posible eliminar "${name}" porque tiene ${count} pendiente(s) asociado(s).\n\nPara eliminarlo, primero reasigna o cambia el estatus de dichos pendientes en el panel principal.`
      );
      return;
    }

    const confirmed = window.confirm(
      `¿Estás seguro de que deseas eliminar permanentemente el estatus "${name}"?`
    );
    if (!confirmed) return;

    try {
      btnDelete.disabled = true;
      const res = await fetch(`/api/estatus?id=${id}`, {
        method: 'DELETE',
      });
      const result = (await res.json()) as { ok?: boolean; error?: string };

      if (!res.ok || !result.ok) {
        alert(result.error || 'Ocurrió un error al eliminar el estatus.');
        return;
      }

      modal?.close();
      window.location.reload();
    } catch (err) {
      alert('Error de conexión al eliminar el estatus.');
    } finally {
      btnDelete.disabled = false;
    }
  });

  // Guardar Cambios o Crear Nuevo
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btnSubmit) return;

    const idVal = fId?.value.trim();
    const nombre = fNombre?.value.trim();
    let codigo = fCodigo?.value.trim().toLowerCase();
    const color = fColor?.value.trim();

    if (!nombre) {
      alert('El nombre es obligatorio.');
      fNombre?.focus();
      return;
    }

    if (!codigo) {
      codigo = slugify(nombre);
    }

    const payload = {
      ...(idVal ? { id: Number(idVal) } : {}),
      nombre,
      codigo,
      color: color || '#1e3a8a',
    };

    try {
      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Guardando...';

      const method = idVal ? 'PATCH' : 'POST';
      const res = await fetch('/api/estatus', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = (await res.json()) as { ok?: boolean; error?: string; data?: EstatusRecord };

      if (!res.ok || !result.ok) {
        alert(result.error || 'Ocurrió un error al guardar el estatus en Cloudflare D1.');
        return;
      }

      modal?.close();
      window.location.reload();
    } catch (err) {
      alert('Error de conexión al comunicarse con el servidor.');
    } finally {
      btnSubmit.disabled = false;
    }
  });

  // Cierre al hacer clic en el backdrop
  if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
    modal.addEventListener('click', (event) => {
      if (event.target !== modal) return;
      const rect = modal.getBoundingClientRect();
      const isDialogContent =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (isDialogContent) return;
      modal.close();
    });
  }
</script>
